# AsztalosPro környezeti változók — PÉLDA
# Másold át .env néven és töltsd ki a valós értékekkel!

# Szerver
PORT=3000

# Production mód (secure cookie, view cache, stack trace elrejtés)
# NODE_ENV=production

# Admin jelszó — KÖTELEZŐ! (enélkül a szerver nem indul)
ADMIN_PASSWORD=changeMe123

# Session titkosítás — KÖTELEZŐ! Erős, hosszú, véletlenszerű érték!
SESSION_SECRET=changeMeToALongRandomString

# Proxy (Cloudflare, nginx reverse proxy) mögött futás esetén:
# TRUST_PROXY=1
# CF_IPS=1.2.3.4,5.6.7.8   (opcionális: megbízható proxy IP-k listája)

# SMTP / e-mail értesítések
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USER=you@example.com
# MAIL_PASS=your-app-password
# MAIL_FROM=you@example.com
# MAIL_TO=you@example.com

# VAPID kulcsok (Web Push értesítésekhez)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Sitemap base URL (szabadon választható domain)
# SITEMAP_BASE_URL=https://www.asztalospro.hu

# Google PageSpeed Insights (opcionális, ha API kulcs van)
# PAGESPEED_API_KEY=
