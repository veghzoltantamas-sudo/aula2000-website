<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#d5ab5d">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icons/icon-192.png" type="image/png">
    <link rel="apple-touch-icon" href="/icons/icon-192.png">
    <title>Prémium ajánlatkérés - <%= content.site_title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;700&family=Open+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/quote.css">
</head>
<body>
    <nav class="py-3 border-bottom bg-white"><div class="container d-flex justify-content-between align-items-center">
        <a href="/" class="text-decoration-none fw-bold" style="color:var(--ink)"><%= content.site_title %></a>
        <a href="/" class="text-muted text-decoration-none">Vissza a főoldalra</a>
    </div></nav>
    <main class="container quote-hero">
        <div class="text-center mb-4">
            <div class="step">Személyre szabott tervezés</div>
            <h1 class="display-5 fw-bold mt-2">Prémium ajánlatkérő konfigurátor</h1>
            <p class="lead text-muted mx-auto" style="max-width:700px">Néhány részlet alapján előkészítjük az első konzultációt. A megadott adatokat bizalmasan kezeljük.</p>
        </div>
        <% if (submitted) { %><div class="alert alert-success text-center">Köszönjük! Ajánlatkérését megkaptuk, hamarosan jelentkezünk.</div><% } %>
        <form action="/quote" method="POST" class="quote-card">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="row g-4">
                <div class="col-12"><h2 class="h4 mb-0">Az elképzelés</h2></div>
                <div class="col-md-6"><label class="form-label">Milyen munkát tervez?</label><select name="service_type" class="form-select" required><option value="">Válasszon</option><option>Generál tervezés</option><option>Beruházás bonyolítás</option><option>Látványtervezés</option><option>Energetikai tanúsítás</option><option>Felújítás tervezése</option><option>Egyéb</option></select></div>
                <div class="col-md-6"><label class="form-label">Helyiség / projekt mérete</label><input name="project_scope" class="form-control" placeholder="Pl. 18 m²-es konyha"></div>
                <div class="col-md-4"><label class="form-label">Helyiségek száma</label><input name="room_count" class="form-control" placeholder="Pl. 2"></div>
                <div class="col-md-8"><label class="form-label">Becsült méretek</label><input name="dimensions" class="form-control" placeholder="Pl. 360 × 240 cm"></div>
                <div class="col-md-6"><label class="form-label">Anyag / fafajta</label><input name="material" class="form-control" placeholder="Pl. tölgy, dió, festett MDF"></div>
                <div class="col-md-6"><label class="form-label">Felület / szín</label><input name="finish" class="form-control" placeholder="Pl. matt fekete, natúr olaj"></div>
                <div class="col-md-6"><label class="form-label">Tervezett keret</label><select name="budget" class="form-select"><option value="">Válasszon</option><option>500 000 Ft alatt</option><option>500 000 – 1 500 000 Ft</option><option>1 500 000 – 3 000 000 Ft</option><option>3 000 000 Ft felett</option><option>Még nem tudom</option></select></div>
                <div class="col-md-6"><label class="form-label">Kívánt kezdés</label><select name="timeline" class="form-select"><option value="">Válasszon</option><option>Azonnal / 1 hónapon belül</option><option>1–3 hónapon belül</option><option>3–6 hónapon belül</option><option>Rugalmas</option></select></div>
                <div class="col-md-6"><label class="form-label">Van alaprajz vagy látványterv?</label><select name="has_plan" class="form-select"><option value="">Válasszon</option><option>Igen</option><option>Még nincs</option></select></div>
                <div class="col-12"><label class="form-label">További részletek</label><textarea name="notes" rows="4" class="form-control" placeholder="Írja le az elképzelését, különleges igényeit..."></textarea></div>
                <div class="col-12"><hr><h2 class="h4 mb-0">Kapcsolattartási adatok</h2></div>
                <div class="col-md-4"><label class="form-label">Név</label><input name="name" class="form-control" required autocomplete="name"></div>
                <div class="col-md-4"><label class="form-label">E-mail</label><input type="email" name="email" class="form-control" required autocomplete="email"></div>
                <div class="col-md-4"><label class="form-label">Telefon</label><input type="tel" name="phone" class="form-control" autocomplete="tel"></div>
                <div class="col-12 d-flex gap-2 flex-wrap">
                    <button class="btn btn-gold flex-grow-1" type="submit">Ajánlatkérés elküldése</button>
                    <button class="btn btn-outline-secondary" type="button" id="downloadPdfBtn">PDF export</button>
                </div>
            </div>
        </form>
    </main>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="/js/quote.js"></script>
</body>
</html>
