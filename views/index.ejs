                            <div class="small text-white-50"><%= t('pwa.iosDesc') %> <strong><%= t('pwa.iosShare') %></strong> <%= t('pwa.iosDescMid') %> <i class="fa-solid fa-arrow-up-from-bracket"></i>, <%= t('pwa.iosDescEnd') %> <strong>"<%= t('pwa.iosOption') %>"</strong> <%= t('pwa.iosOptionEnd') %></div>
                        </div>
                    </div>
