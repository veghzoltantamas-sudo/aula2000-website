                    <div class="d-flex align-items-start gap-3">
                        <i class="fa-solid fa-desktop text-light fs-5 mt-1"></i>
                        <div>
                            <div class="fw-bold small text-light"><%= t('pwa.desktop') %></div>
                            <div class="small text-white-50"><%= t('pwa.desktopDesc') %> <strong><%= t('pwa.desktopInstall') %></strong> <%= t('pwa.desktopDescEnd') %></div>
                        </div>
                    </div>
                </div>

                <div id="pwaDirectInstallWrap" class="d-none text-center">
                    <button type="button" id="pwaDirectInstallBtn" class="btn btn-wood w-100 py-2 fw-bold">
                        <i class="fa-solid fa-download me-2"></i> <%= t('pwa.installBtn') %>
