            <div class="small text-white-50"><%= t('socialProof.text2') %></div>
        </div>
    </div>
</div>

<% if (settings.enable_floating_contact == '1') { %>
<div class="floating-contact-actions" aria-label="<%= t('ui.quickContact') %>">
