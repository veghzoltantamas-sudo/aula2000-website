                </div>
            </div>
            <div class="modal-footer border-top border-secondary">
                <button type="button" class="btn btn-outline-secondary w-100" data-bs-dismiss="modal"><%= t('pwa.okBtn') %></button>
            </div>
        </div>
    </div>
</div>

<%- include('partials/index-footer', { promoDeadline: promoDeadline }) %>
<script>
(function(){
    function initBeforeAfter() {
        var sliders = document.querySelectorAll('.before-after-slider');
        sliders.forEach(function(slider) {
            if (slider.dataset.bound) return;
            slider.dataset.bound = '1';
            var wrap = slider.closest('.before-after-compare');
            if (!wrap) return;
            function update(val) {
                wrap.style.setProperty('--pos', val + '%');
            }
            var updateAll = function(){ update(parseInt(slider.value, 10) || 50); };
            slider.addEventListener('input', updateAll);
            updateAll();
        });
    }
    document.addEventListener('DOMContentLoaded', initBeforeAfter);
    if (document.readyState !== 'loading') initBeforeAfter();
    window.addEventListener('load', initBeforeAfter);
})();
</script>
</body>
</html>