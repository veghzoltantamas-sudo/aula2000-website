<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ügyfélkapu - Aula 2000</title>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>
    <div class="login-box">
        <h3 class="text-center fw-bold mb-2" style="color: #f5efe9;">AULA <span style="color: #cca300;">2000</span></h3>
        <p class="text-center mb-4" style="color: rgba(255,255,255,0.6); font-size: 0.85rem;">
            <i class="fa-solid fa-user-lock me-1"></i> Ügyfélkapu
        </p>
        <% if(error) { %><div class="alert alert-danger text-center"><%= error %></div><% } %>
        <form action="/ugyfel/login" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="text" name="username" class="form-control" placeholder="Felhasználónév" required autofocus>
            <input type="password" name="password" class="form-control" placeholder="Jelszó" required>
            <button type="submit" class="btn-wood">Belépés</button>
        </form>
        <p class="text-center mt-3" style="color: rgba(255,255,255,0.4); font-size: 0.8rem;">
            <a href="/" style="color: rgba(255,255,255,0.5); text-decoration: none;">← Vissza a főoldalra</a>
        </p>
    </div>
</body>
</html>