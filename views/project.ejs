<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#d5ab5d">
    <meta name="description" content="<%= project.description || project.title %>">
    <meta property="og:type" content="article">
    <meta property="og:title" content="<%= project.title %> - <%= content.site_title %>">
    <meta property="og:description" content="<%= project.description || project.title %>">
    <meta property="og:image" content="<%= project.cover || '/icons/icon-512.png' %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icons/icon-192.png" type="image/png">
    <link rel="apple-touch-icon" href="/icons/icon-192.png">
    <title><%= project.title %> - <%= content.site_title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;700&family=Open+Sans:wght@300;400;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.css" />
    <link rel="stylesheet" href="/css/project.css">
</head>
<body>

<% const optimizeImage = (src, width = 1200) => {
    if (!src) return 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=' + width + '&q=80';
    if (src.startsWith('http')) {
        const sep = src.includes('?') ? '&' : '?';
        return src.includes('images.unsplash.com') ? `${src}${sep}auto=format&fit=crop&w=${width}&q=80` : src;
    }
    return '/uploads/' + src;
}; %>

<nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
        <a class="navbar-brand" href="/?from=gallery#referenciak"><i class="fa-solid fa-arrow-left me-2 text-muted" style="font-size:1rem;"></i> <%= content.site_title %></a>
    </div>
</nav>

<div class="container py-5">
    <div class="text-center mb-5">
        <div class="project-category"><%= project.category %></div>
        <h1 class="project-title"><%= project.title %></h1>
    </div>

    <div class="row g-5">
        <div class="col-lg-8">
            <% const mainCover = optimizeImage(project.cover, 1400); %>
            <a data-fancybox="gallery" href="<%= mainCover %>">
                <img src="<%= mainCover %>" srcset="<%= optimizeImage(project.cover, 600) %> 600w, <%= optimizeImage(project.cover, 1000) %> 1000w, <%= optimizeImage(project.cover, 1400) %> 1400w" sizes="(max-width: 768px) 100vw, 70vw" class="main-img mb-4" alt="<%= project.title %>" loading="eager" decoding="async" fetchpriority="high" width="1200" height="750">
            </a>

            <% if(images && images.length > 0) { %>
            <div class="row g-2">
                <% images.forEach(img => { %>
                <% const gallerySrc = optimizeImage(img.filename, 700); %>
                <div class="col-3">
                    <a data-fancybox="gallery" href="<%= gallerySrc %>">
                        <img src="<%= gallerySrc %>" srcset="<%= optimizeImage(img.filename, 320) %> 320w, <%= optimizeImage(img.filename, 480) %> 480w, <%= optimizeImage(img.filename, 700) %> 700w" sizes="(max-width: 768px) 25vw, 150px" class="thumb-img shadow-sm" alt="<%= project.title %>" loading="lazy" decoding="async" width="300" height="180">
                    </a>
                </div>
                <% }) %>
            </div>
            <% } %>
        </div>
        
        <div class="col-lg-4">
            <div class="info-box sticky-top" style="top: 100px;">
                <h4 class="fw-bold mb-4 border-bottom pb-3">A Munka Részletei</h4>
                <% const meta = [['Ügyfél', project.client], ['Helyszín', project.location], ['Év', project.project_year], ['Időtartam', project.duration], ['Anyagok', project.materials]].filter(item => item[1]); %>
                <% if (meta.length) { %><div class="case-meta"><% meta.forEach(item => { %><div><small><%= item[0] %></small><span><%= item[1] %></span></div><% }) %></div><% } %>
                <p class="text-muted lh-lg" style="white-space: pre-wrap; font-size: 1.05rem;"><%= project.description %></p>
                
                <div class="mt-5 text-center">
                    <p class="text-muted small mb-3">Tetszik Önnek is ez a stílus?</p>
                    <a href="/#kapcsolat" class="btn-wood w-100 py-3"><i class="fa-regular fa-envelope me-2"></i> Kérjen Ajánlatot</a>
                </div>
            </div>
        </div>
        <% if (project.challenge || project.solution || project.result || project.testimonial) { %>
        <div class="row mt-5"><div class="col-lg-8">
            <% if (project.challenge) { %><section class="case-section"><h2>A kihívás</h2><p class="text-muted lh-lg" style="white-space:pre-wrap"><%= project.challenge %></p></section><% } %>
            <% if (project.solution) { %><section class="case-section"><h2>Megoldás és kivitelezés</h2><p class="text-muted lh-lg" style="white-space:pre-wrap"><%= project.solution %></p></section><% } %>
            <% if (project.result) { %><section class="case-section"><h2>Az eredmény</h2><p class="text-muted lh-lg" style="white-space:pre-wrap"><%= project.result %></p></section><% } %>
            <% if (project.testimonial) { %><blockquote class="case-section case-quote"><%= project.testimonial %></blockquote><% } %>
        </div></div>
        <% } %>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.umd.js"></script>
<script src="/js/project.js"></script>
</body>
</html>