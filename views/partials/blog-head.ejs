<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,700;1,400&family=Open+Sans:wght@300;400;600&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="/vendor/fontawesome/css/all.min.css" rel="stylesheet">
<link rel="stylesheet" href="/css/main.css">
<% if (settings.enable_dark_mode == '1') { %>
<link rel="stylesheet" href="/css/theme-toggle.css">
<script src="/js/theme-toggle.js" defer></script>
<% } %>
<style>
    :root { --bg: #0a0d11; --panel: #17191c; --gold: <%= (settings && settings.brand_primary_color) || '#d5ab5d' %>; --text: <%= (settings && settings.brand_secondary_color) || '#f5efe8' %>; --muted: #8a8a8a; }
    * { box-sizing: border-box; }
    body { background: var(--bg); color: var(--text); font-family: 'Open Sans', sans-serif; margin: 0; }
    a { color: var(--gold); }
</style>
