<!-- ============================================================
     ADMIN SCRIPTEK
     A böngészőbeli (kliens) JS logika a public/js/admin.js-ben van;
     itt csak a CDN függőségek és a szerver-oldali config maradnak.
     ============================================================ -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/easymde@2.18.0/dist/easymde.min.js"></script>

<script>
// Szerver-oldali (EJS) értékek a külső admin.js számára.
// Ha a csrf token hiányzik (pl. még nincs session), üres stringöt adunk,
// így az admin.js fetch hívásai 403-at kapnak a szervertől — ugyanaz,
// mint a korábbi inline verzió viselkedése lapfrissítés nélkül.
window.AdminConfig = {
    csrfToken: "<%= csrfToken %>"
};
</script>

<script src="/js/admin.js?v=<%= Date.now() %>"></script>
<script src="/js/admin-responsive.js?v=<%= Date.now() %>"></script>
<script src="/js/admin-faq-editor.js?v=<%= Date.now() %>"></script>
</body>
