<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Galéria - Aula 2000</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
    <style>
        :root{--gold:#c9a96e;--gold-light:#dfc692;--dark:#0f0f0f;--darker:#080808;--card:#161616;--card-hover:#1c1c1c;--text:#e8e0d4;--text-dim:rgba(232,224,212,0.55);--text-muted:rgba(232,224,212,0.35);--border:rgba(201,169,110,0.12);--border-hover:rgba(201,169,110,0.3);--gold-glow:rgba(201,169,110,0.15)}
        *{margin:0;padding:0;box-sizing:border-box}
        body{background:var(--darker);color:var(--text);font-family:"Inter",sans-serif;min-height:100vh;overflow-x:hidden}
        a{text-decoration:none}

        /* ===== NAV ===== */
        .c-nav{background:rgba(15,15,15,0.95);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:0.8rem 0;position:sticky;top:0;z-index:100}
        .c-nav .brand{color:var(--text);font-family:"Playfair Display",serif;font-weight:700;font-size:1.15rem}
        .c-nav .brand span{color:var(--gold)}
        .c-nav .user-info{color:var(--text-dim);font-size:0.8rem}
        .c-nav .user-info strong{color:var(--gold)}
        .c-nav .btn-ghost{color:var(--text-muted);font-size:0.8rem;padding:0.3rem 0.7rem;border:1px solid var(--border);border-radius:6px;transition:all 0.2s}
        .c-nav .btn-ghost:hover{color:var(--gold);border-color:var(--border-hover)}

        /* ===== TABS ===== */
        .c-tabs{display:flex;gap:0.3rem;padding:1.2rem 0 0}
        .c-tab{color:var(--text-muted);font-size:0.85rem;font-weight:500;padding:0.6rem 1.2rem;border-radius:8px 8px 0 0;border:1px solid transparent;border-bottom:none;transition:all 0.25s;cursor:pointer}
        .c-tab:hover{color:var(--text-dim);background:rgba(201,169,110,0.05)}
        .c-tab.active{color:var(--gold);background:var(--card);border-color:var(--border)}

        /* ===== GALLERY HEADER ===== */
        .gallery-header{padding:2rem 0 1rem;opacity:0;transform:translateY(20px);animation:fadeUp 0.6s ease forwards}
        .gallery-header h1{font-family:"Playfair Display",serif;font-size:1.8rem;font-weight:700}
        .gallery-header h1 span{color:var(--gold)}
        .gallery-header p{color:var(--text-dim);font-size:0.9rem;margin-top:0.3rem}
        .stats-row{display:flex;gap:1rem;margin-top:1rem;flex-wrap:wrap}
        .stat-badge{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:0.5rem 1rem;font-size:0.8rem;color:var(--text-dim);transition:all 0.3s}
        .stat-badge:hover{border-color:var(--border-hover);transform:translateY(-1px)}
        .stat-badge strong{color:var(--gold);font-weight:600}

        /* ===== GALLERY GRID ===== */
        .gallery-grid{columns:3;column-gap:1rem;padding:1.5rem 0 3rem}
        @media(max-width:992px){.gallery-grid{columns:2}}
        @media(max-width:576px){.gallery-grid{columns:1}}
        .gallery-item{break-inside:avoid;margin-bottom:1rem;border-radius:10px;overflow:hidden;position:relative;background:var(--card);border:1px solid var(--border);transition:all 0.4s cubic-bezier(0.4,0,0.2,1);cursor:pointer;opacity:0;transform:translateY(30px)}
        .gallery-item.visible{opacity:1;transform:translateY(0)}
        .gallery-item:hover{border-color:var(--border-hover);transform:translateY(-4px);box-shadow:0 12px 40px rgba(0,0,0,0.5),0 0 0 1px rgba(201,169,110,0.1)}
        .gallery-item img{width:100%;display:block;transition:transform 0.6s cubic-bezier(0.4,0,0.2,1)}
        .gallery-item:hover img{transform:scale(1.05)}
        .gallery-item .overlay{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(0,0,0,0.9));padding:1.8rem 1rem 1rem;opacity:0;transition:opacity 0.3s}
        .gallery-item:hover .overlay{opacity:1}
        .overlay .filename{font-size:0.8rem;color:var(--text);font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .overlay .meta{font-size:0.7rem;color:var(--text-muted);margin-top:0.2rem}
        .gallery-item .zoom-hint{position:absolute;top:0.6rem;right:0.6rem;width:28px;height:28px;background:rgba(0,0,0,0.6);backdrop-filter:blur(8px);border-radius:50%;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.3s;font-size:0.7rem;color:var(--gold)}
        .gallery-item:hover .zoom-hint{opacity:1}

        /* ===== EMPTY STATE ===== */
        .empty-state{text-align:center;padding:4rem 2rem}
        .empty-state i{font-size:3rem;color:rgba(201,169,110,0.2);margin-bottom:1rem;display:block}
        .empty-state h4{color:var(--text-dim);font-weight:500;font-size:1.1rem}
        .empty-state p{color:var(--text-muted);font-size:0.85rem;margin-top:0.4rem}

        /* ===== LIGHTBOX (TELJES KÉPERNYŐ) ===== */
        .lightbox{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.97);z-index:1000;align-items:center;justify-content:center;flex-direction:column;opacity:0;transition:opacity 0.3s}
        .lightbox.open{display:flex;opacity:1}
        .lightbox img{max-width:92vw;max-height:78vh;object-fit:contain;border-radius:6px;transition:opacity 0.3s,transform 0.3s;user-select:none;-webkit-user-select:none}
        .lightbox.img-entering{opacity:0;transform:scale(0.95)}
        .lightbox.img-visible{opacity:1;transform:scale(1)}
        .lb-close{position:absolute;top:1rem;right:1rem;background:rgba(255,255,255,0.08);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.1);color:white;width:40px;height:40px;border-radius:50%;font-size:1.1rem;cursor:pointer;z-index:10;display:flex;align-items:center;justify-content:center;transition:all 0.2s}
        .lb-close:hover{background:rgba(201,169,110,0.3);border-color:var(--gold)}
        .lb-info{color:rgba(255,255,255,0.8);text-align:center;padding:0.8rem;max-width:90vw;opacity:0;animation:fadeIn 0.4s 0.2s ease forwards}
        .lb-info .name{font-weight:500;font-size:0.9rem}
        .lb-info .details{font-size:0.75rem;color:rgba(255,255,255,0.5);margin-top:0.2rem}
        .lb-actions{display:flex;gap:0.8rem;padding:0.5rem;opacity:0;animation:fadeIn 0.4s 0.3s ease forwards}
        .lb-btn{padding:0.5rem 1.2rem;border-radius:8px;font-size:0.8rem;text-decoration:none;border:1px solid rgba(255,255,255,0.15);color:rgba(255,255,255,0.8);transition:all 0.2s;display:inline-flex;align-items:center}
        .lb-btn:hover{border-color:var(--gold);color:var(--gold)}
        .lb-btn.primary{background:var(--gold);color:var(--dark);border-color:var(--gold);font-weight:500}
        .lb-btn.primary:hover{background:var(--gold-light)}
        .lb-nav{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,0.06);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.08);color:white;width:48px;height:48px;border-radius:50%;font-size:1.1rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.2s;z-index:10}
        .lb-nav:hover{background:rgba(201,169,110,0.3);border-color:rgba(201,169,110,0.4)}
        .lb-nav.prev{left:1rem}
        .lb-nav.next{right:1rem}
        .lb-counter{position:absolute;top:1rem;left:50%;transform:translateX(-50%);color:rgba(255,255,255,0.4);font-size:0.75rem;font-weight:500;letter-spacing:1px}
        @media(max-width:576px){
            .lb-nav{width:38px;height:38px;font-size:0.9rem}
            .lb-nav.prev{left:0.5rem}
            .lb-nav.next{right:0.5rem}
            .lb-close{top:0.5rem;right:0.5rem;width:36px;height:36px}
        }

        /* ===== ANIMATIONS ===== */
        @keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
        @keyframes fadeIn{from{opacity:0}to{opacity:1}}
        @keyframes pulse{0%,100%{opacity:1}50%{opacity:0.5}}
    </style>
</head>
<body>
<nav class="c-nav">
    <div class="container d-flex justify-content-between align-items-center">
        <a href="/ugyfel/projekt" class="brand">AULA <span>2000</span></a>
        <div class="d-flex align-items-center gap-3">
            <span class="user-info"><i class="fa-solid fa-user me-1"></i> <strong><%= user.display_name || user.username %></strong> &mdash; <%= user.project_name || "" %></span>
            <a href="/ugyfel/logout" class="btn-ghost"><i class="fa-solid fa-right-from-bracket me-1"></i> Kilépés</a>
        </div>
    </div>
</nav>
<div class="container" style="max-width:1100px;">
    <div class="c-tabs">
        <a href="/ugyfel/projekt" class="c-tab"><i class="fa-solid fa-timeline me-1"></i> Frissítések</a>
        <a href="/ugyfel/galeria" class="c-tab active"><i class="fa-solid fa-images me-1"></i> Galéria</a>
    </div>
    <div class="gallery-header">
        <h1><i class="fa-solid fa-images me-2" style="font-size:1.4rem;"></i><span>Galéria</span></h1>
        <p><%= user.project_name || "Projekt" %> &mdash; projekthez tartozó képek és grafikák</p>
        <div class="stats-row">
            <div class="stat-badge"><i class="fa-solid fa-photo-film me-1" style="color:var(--gold);"></i> <strong><%= images.length %></strong> kép feltöltve</div>
            <% const totalSize = images.reduce((s,i)=>s+(i.size||0),0); %>
            <div class="stat-badge"><i class="fa-solid fa-database me-1" style="color:var(--gold);"></i> Összes méret: <strong><%= totalSize > 1048576 ? (totalSize/1048576).toFixed(1)+' MB' : (totalSize/1024).toFixed(0)+' KB' %></strong></div>
        </div>
    </div>
    <% if(images.length > 0) { %>
    <div class="gallery-grid" id="galleryGrid">
        <% images.forEach((img, idx) => { %>
        <div class="gallery-item" data-idx="<%= idx %>">
            <img src="<%= img.thumb_name ? '/ugyfel/fajl/'+img.id+'/thumb' : '/ugyfel/fajl/'+img.id %>" alt="<%= img.original_name %>" loading="lazy">
            <div class="zoom-hint"><i class="fa-solid fa-expand"></i></div>
            <div class="overlay">
                <div class="filename"><i class="fa-solid fa-image me-1" style="color:var(--gold);font-size:0.7rem;"></i> <%= img.original_name %></div>
                <div class="meta"><%= img.update_title ? img.update_title+' &mdash; ' : '' %><%= img.size ? (img.size/1024).toFixed(0)+' KB' : '' %></div>
            </div>
        </div>
        <% }) %>
    </div>
    <% } else { %>
    <div class="empty-state">
        <i class="fa-regular fa-image"></i>
        <h4>Még nincsenek képek a galériában</h4>
        <p>A projekthez feltöltött képek itt jelennek meg automatikusan.</p>
    </div>
    <% } %>
</div>

<!-- ===== FULLSCREEN LIGHTBOX ===== -->
<div class="lightbox" id="lightbox">
    <div class="lb-counter" id="lb-counter"></div>
    <button class="lb-close" id="lb-close-btn" aria-label="Bezárás"><i class="fa-solid fa-xmark"></i></button>
    <button class="lb-nav prev" id="lb-prev-btn" aria-label="Előző"><i class="fa-solid fa-chevron-left"></i></button>
    <button class="lb-nav next" id="lb-next-btn" aria-label="Következő"><i class="fa-solid fa-chevron-right"></i></button>
    <img id="lb-img" src="" alt="" draggable="false">
    <div class="lb-info"><div class="name" id="lb-name"></div><div class="details" id="lb-details"></div></div>
    <div class="lb-actions">
        <a class="lb-btn" id="lb-fullscreen" href="javascript:void(0)"><i class="fa-solid fa-maximize me-1"></i> Teljes képernyő</a>
        <a class="lb-btn" id="lb-view" href="" target="_blank"><i class="fa-solid fa-up-right-from-square me-1"></i> Megnyitás</a>
        <a class="lb-btn primary" id="lb-download" href="" download><i class="fa-solid fa-download me-1"></i> Letöltés</a>
    </div>
</div>

<script>
const images = <%- JSON.stringify(images.map(i => ({ id:i.id, name:i.original_name, size:i.size, update_title:i.update_title||'', thumb: i.thumb_name ? '/ugyfel/fajl/'+i.id+'/thumb' : '/ugyfel/fajl/'+i.id, full: '/ugyfel/fajl/'+i.id })) ) %>;
let currentIdx = 0;
let touchStartX = 0;
let touchStartY = 0;
let isSwiping = false;
const lb = document.getElementById('lightbox');
const lbImg = document.getElementById('lb-img');

function openLightbox(idx) {
    if(idx < 0 || idx >= images.length) return;
    currentIdx = idx;
    const img = images[idx];
    lbImg.classList.add('img-entering');
    lbImg.classList.remove('img-visible');
    lbImg.src = img.full;
    lbImg.alt = img.name;
    document.getElementById('lb-name').textContent = img.name;
    document.getElementById('lb-details').textContent = (img.update_title ? img.update_title+' — ' : '') + (img.size ? (img.size/1024).toFixed(0)+' KB' : '');
    document.getElementById('lb-view').href = img.full;
    document.getElementById('lb-download').href = img.full + '?dl=1';
    document.getElementById('lb-counter').textContent = (idx+1) + ' / ' + images.length;
    // Előző/következő gombok láthatósága
    document.getElementById('lb-prev-btn').style.display = idx > 0 ? '' : 'none';
    document.getElementById('lb-next-btn').style.display = idx < images.length-1 ? '' : 'none';
    lb.classList.add('open');
    document.body.style.overflow = 'hidden';
    lbImg.onload = function() {
        lbImg.classList.remove('img-entering');
        lbImg.classList.add('img-visible');
    };
}

function closeLightbox() {
    lb.classList.remove('open');
    document.body.style.overflow = '';
    lbImg.classList.remove('img-visible');
    if(document.fullscreenElement) document.exitFullscreen().catch(()=>{});
}

function navigateLightbox(dir) {
    const next = currentIdx + dir;
    if(next >= 0 && next < images.length) openLightbox(next);
}

function goFullscreen() {
    if(!document.fullscreenElement && !document.webkitFullscreenElement) {
        const el = lb.requestFullscreen ? lb : lb.webkitRequestFullscreen;
        if(el) el.call(lb);
    } else {
        (document.exitFullscreen || document.webkitExitFullscreen).call(document);
    }
}

// ===== CSP-KOMPATILIS EVENT LISTENERS =====
// Galéria item kattintás (event delegation)
document.getElementById('galleryGrid').addEventListener('click', function(e) {
    const item = e.target.closest('.gallery-item');
    if(item) openLightbox(parseInt(item.dataset.idx, 10));
});

// Lightbox gombok
document.getElementById('lb-close-btn').addEventListener('click', closeLightbox);
document.getElementById('lb-prev-btn').addEventListener('click', function(e) { e.stopPropagation(); navigateLightbox(-1); });
document.getElementById('lb-next-btn').addEventListener('click', function(e) { e.stopPropagation(); navigateLightbox(1); });
document.getElementById('lb-fullscreen').addEventListener('click', function(e) { e.preventDefault(); goFullscreen(); });

// Billentyűzet navigáció
document.addEventListener('keydown', function(e) {
    if(!lb.classList.contains('open')) return;
    if(e.key === 'Escape') closeLightbox();
    if(e.key === 'ArrowRight') navigateLightbox(1);
    if(e.key === 'ArrowLeft') navigateLightbox(-1);
    if(e.key === 'f' || e.key === 'F') goFullscreen();
});

// ===== SWIPE TÁMOGATÁS MOBILON =====
lb.addEventListener('touchstart', function(e) {
    touchStartX = e.changedTouches[0].screenX;
    touchStartY = e.changedTouches[0].screenY;
    isSwiping = false;
}, {passive:true});

lb.addEventListener('touchmove', function(e) {
    var dx = Math.abs(e.changedTouches[0].screenX - touchStartX);
    var dy = Math.abs(e.changedTouches[0].screenY - touchStartY);
    if(dx > 10 && dx > dy * 1.5) {
        isSwiping = true;
        e.preventDefault();
    }
}, {passive:false});

lb.addEventListener('touchend', function(e) {
    if(!isSwiping) return;
    var dx = e.changedTouches[0].screenX - touchStartX;
    if(dx < -40) navigateLightbox(1);
    else if(dx > 40) navigateLightbox(-1);
    isSwiping = false;
}, {passive:true});

// ===== SCROLL ANIMÁCIÓK (IntersectionObserver) =====
var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
        if(entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
        }
    });
}, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });

document.querySelectorAll('.gallery-item').forEach(function(el, i) {
    el.style.transitionDelay = (i % 6) * 80 + 'ms';
    observer.observe(el);
});
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
