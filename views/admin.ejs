                                <p class="text-muted mb-0">Még nincs létrehozott oldal.</p>
                            <% } else { %>
                                <% pages.forEach(page => { %>
                                <div class="page-list-item">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <div class="fw-bold text-white"><%= page.title %></div>
                                            <div class="small text-muted">/page/<%= page.slug %></div>
                                        </div>
                                        <span class="badge bg-secondary"><%= page.status %></span>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    </div>
                                    <div class="mt-3 d-flex gap-2 flex-wrap">
                                        <a href="/page/<%= page.slug %>" target="_blank" class="btn btn-sm btn-outline-light">Megnyitás</a>
                                        <button type="button"
                                            class="btn btn-sm btn-outline-warning edit-page-btn"
                                            data-page-id="<%= page.id %>"
                                            data-page-title="<%= page.title %>"
                                            data-page-slug="<%= page.slug %>"
                                            data-page-status="<%= page.status %>"
                                            data-page-content="<%= page.content_json ? page.content_json.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/'/g, '&#39;').replace(/</g, '&lt;').replace(/>/g, '&gt;') : '[]' %>">
