            </div>
            <div class="card mb-4">
                <div class="card-header"><i class="fa-solid fa-toggle-on me-2"></i> Ügyfélkapu engedélyezése</div>
                <div class="card-body">
                    <form action="/admin/ugyfelkapu/toggle" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" name="ugyfelkapu_enabled" value="1" <%= (settings.ugyfelkapu_enabled === '1') ? 'checked' : '' %>>
                            <label class="form-check-label">Ügyfélkapu bekapcsolása — a kliens bejelentkezési oldal elérhető lesz a <code>/ugyfel/login</code> útvonalon</label>
                        </div>
                        <button type="submit" class="btn btn-wood btn-sm"><i class="fa-solid fa-floppy-disk me-2"></i> Mentés</button>
                    </form>
                </div>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-md-3"><div class="summary-card"><span class="summary-label">Ügyfelek</span><strong><%= clientUsers.length %></strong><small>Regisztrált</small></div></div>
                <div class="col-md-3"><div class="summary-card"><span class="summary-label">Frissítések</span><strong><%= clientUpdates.length %></strong><small>Projekt bejegyzés</small></div></div>
                <div class="col-md-3"><div class="summary-card"><span class="summary-label">Fájlok</span><strong><%= clientFiles.length %></strong><small>Feltöltött</small></div></div>
                <div class="col-md-3"><div class="summary-card"><span class="summary-label">Státusz</span><strong style="color:<%= settings.ugyfelkapu_enabled === '1' ? '#28a745' : '#dc3545' %>"><%= settings.ugyfelkapu_enabled === '1' ? 'BE' : 'KI' %></strong><small>Kapcsoló</small></div></div>
            </div>

                        <!-- Új ügyfél létrehozása -->
            <div class="card mb-4">
                <div class="card-header"><i class="fa-solid fa-user-plus me-2"></i> Új ügyfél létrehozása</div>
                <div class="card-body">
                    <form action="/admin/ugyfelkapu/client-create" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label small">Felhasználónév *</label>
                                <input type="text" name="username" class="form-control" placeholder="pl. kovacs-janos" required>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Jelszó *</label>
                                <input type="text" name="password" class="form-control" placeholder="Legalább 4 karakter" required>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Név</label>
                                <input type="text" name="display_name" class="form-control" placeholder="Kovács János">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">E-mail</label>
                                <input type="email" name="email" class="form-control" placeholder="janos@pelda.hu">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Projekt neve</label>
                                <input type="text" name="project_name" class="form-control" placeholder="pl. Családi ház felújítás">
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <button type="submit" class="btn btn-wood"><i class="fa-solid fa-plus me-2"></i> Létrehozás</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Ügyfelek listája -->
            <div class="card mb-4">
                <div class="card-header"><i class="fa-solid fa-users me-2"></i> Regisztrált ügyfelek (<%= clientUsers.length %>)</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-dark"><tr>
                                <th>ID</th><th>Felhasználónév</th><th>Név</th><th>Projekt</th><th>Státusz</th><th></th>
                            </tr></thead>
                            <tbody>
                                <% clientUsers.forEach(u => { %>
                                <tr>
                                    <td><%= u.id %></td>
                                    <td><strong><%= u.username %></strong></td>
                                    <td><%= u.display_name || "-" %></td>
                                    <td><%= u.project_name || "-" %></td>
                                    <td>
                                        <form action="/admin/ugyfelkapu/client-toggle/<%= u.id %>" method="POST" style="display:inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-sm <%= u.is_active ? 'btn-outline-success' : 'btn-outline-secondary' %>">
                                                <i class="fa-solid fa-<%= u.is_active ? 'check' : 'xmark' %>"></i> <%= u.is_active ? 'Aktív' : 'Inaktív' %>
                                            </button>
                                        </form>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-warning me-1" data-bs-toggle="modal" data-bs-target="#editClientModal<%= u.id %>"><i class="fa-solid fa-pen"></i></button>
                                        <form action="/admin/ugyfelkapu/client-delete/<%= u.id %>" method="POST" data-confirm="Biztosan törli ezt az ügyfelet és az összes fájlt?" style="display:inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                                <% if(clientUsers.length === 0) { %><tr><td colspan="6" class="text-center py-4 text-muted">Még nincsenek ügyfelek.</td></tr><% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Szerkesztő modálisok -->
            <% clientUsers.forEach(u => { %>
            <div class="modal fade" id="editClientModal<%= u.id %>" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
                <div class="modal-header"><h5 class="modal-title"><i class="fa-solid fa-user-pen me-2"></i> <%= u.username %></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <form action="/admin/ugyfelkapu/client-update/<%= u.id %>" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label small">Név</label><input type="text" name="display_name" class="form-control" value="<%= u.display_name || '' %>"></div>
                    <div class="mb-3"><label class="form-label small">E-mail</label><input type="email" name="email" class="form-control" value="<%= u.email || '' %>"></div>
                    <div class="mb-3"><label class="form-label small">Projekt</label><input type="text" name="project_name" class="form-control" value="<%= u.project_name || '' %>"></div>
                    <div class="mb-3"><label class="form-label small">Új jelszó (opcionális)</label><input type="text" name="new_password" class="form-control" placeholder="Min. 4 karakter"></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Mégse</button><button type="submit" class="btn btn-wood"><i class="fa-solid fa-save me-2"></i> Mentés</button></div>
                </form>
            </div></div></div>
            <% }) %>

            <!-- Új projekt frissítés -->
            <% if(clientUsers.length > 0) { %>
            <div class="card mb-4">
                <div class="card-header"><i class="fa-solid fa-file-circle-plus me-2"></i> Új projekt frissítés</div>
                <div class="card-body">
                    <form action="/admin/ugyfelkapu/update-create" method="POST" enctype="multipart/form-data">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small">Ügyfél *</label>
                                <select name="client_user_id" class="form-select bg-secondary text-white border-0" required>
                                    <option value="">-- Válassz --</option>
                                    <% clientUsers.filter(cu => cu.is_active).forEach(cu => { %>
                                    <option value="<%= cu.id %>"><%= cu.username %> — <%= cu.project_name || cu.display_name || cu.username %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small">Cím</label>
                                <input type="text" name="title" class="form-control" placeholder="pl. Alapozás kész">
                            </div>
                        </div>
                        <div class="mt-3">
                            <label class="form-label small">Tartalom (sima szöveg — *félkövér*, **dőlt**, ## Cím)</label>
                            <textarea name="body_raw" class="form-control" rows="4" placeholder="A projekt állásáról szóló tájékoztatás..."></textarea>
                        </div>
                        <div class="mt-3">
                            <label class="form-label small">Csatolt fájlok (max 10, max 25MB/db)</label>
                            <input type="file" name="files" class="form-control" multiple accept=".jpg,.jpeg,.png,.webp,.gif,.pdf,.zip,.dwg,.doc,.docx">
                        </div>
                        <div class="mt-3"><button type="submit" class="btn btn-wood"><i class="fa-solid fa-paper-plane me-2"></i> Közzététel</button></div>
                    </form>
                </div>
            </div>
            <% } %>

            <!-- Projekt frissítések listája -->
            <div class="card mb-4">
                <div class="card-header"><i class="fa-solid fa-clock-rotate-left me-2"></i> Projekt frissítések (<%= clientUpdates.length %>)</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-dark"><tr><th>ID</th><th>Ügyfél</th><th>Cím</th><th>Fájlok</th><th>Dátum</th><th></th></tr></thead>
                            <tbody>
                                <% clientUpdates.forEach(u => { const cl = clientUsers.find(cu => cu.id === u.client_user_id); const uf = clientFiles.filter(f => f.update_id === u.id); %>
                                <tr>
                                    <td><%= u.id %></td>
                                    <td><strong><%= cl ? cl.username : 'ID:'+u.client_user_id %></strong></td>
                                    <td><%= u.title || '(cím nélkül)' %></td>
                                    <td><span class="badge bg-info"><%= uf.length %> fájl</span></td>
                                    <td><small class="text-muted"><%= u.created_at ? new Date(u.created_at).toLocaleString('hu-HU') : '-' %></small></td>
                                    <td>
                                        <form action="/admin/ugyfelkapu/update-delete/<%= u.id %>" method="POST" data-confirm="Biztosan törli?" style="display:inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                                <% if(clientUpdates.length === 0) { %><tr><td colspan="6" class="text-center py-4 text-muted">Még nincsenek frissítések.</td></tr><% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Összes fájl -->
            <div class="card mb-4">
                <div class="card-header"><i class="fa-solid fa-folder-open me-2"></i> Összes fájl (<%= clientFiles.length %>)</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-dark"><tr><th>ID</th><th>Ügyfél</th><th>Név</th><th>Típus</th><th>Méret</th><th></th></tr></thead>
                            <tbody>
                                <% clientFiles.forEach(f => { const cl = clientUsers.find(cu => cu.id === f.client_user_id); %>
                                <tr>
                                    <td><%= f.id %></td>
                                    <td><strong><%= cl ? cl.username : 'ID:'+f.client_user_id %></strong></td>
                                    <td><%= f.original_name %></td>
                                    <td><code class="small"><%= f.mime_type %></code></td>
                                    <td><%= f.size ? (f.size / 1024).toFixed(1) + ' KB' : '-' %></td>
                                    <td>
                                        <a href="/ugyfel/fajl/<%= f.id %>" target="_blank" class="btn btn-sm btn-outline-info me-1"><i class="fa-solid fa-eye"></i></a>
                                        <form action="/admin/ugyfelkapu/file-delete/<%= f.id %>" method="POST" data-confirm="Törli a fájlt?" style="display:inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                                <% if(clientFiles.length === 0) { %><tr><td colspan="6" class="text-center py-4 text-muted">Még nincsenek fájlok.</td></tr><% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <% } %>

            <!-- BLOG TAB -->
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% if(tab == 'blog') { %>
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold m-0 text-white"><i class="fa-solid fa-pen-nib me-2" style="color:var(--gold)"></i> Blog bejegyzések</h3>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-danger btn-sm" id="bulk-blog-delete-btn" style="display:none" onclick="if(confirm('Biztosan törli a kijelölt bejegyzéseket?')) document.getElementById('bulk-blog-form').submit()"><i class="fa-solid fa-trash me-2"></i> Kijelöltek törlése</button>
                    <button class="btn btn-wood" data-bs-toggle="modal" data-bs-target="#blogCreateModal"><i class="fa-solid fa-plus me-2"></i> Új bejegyzés</button>
                </div>
            </div>

            <form id="bulk-blog-form" action="/admin/blog/bulk-delete" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            </form>

            <div class="card p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead><tr><th><input type="checkbox" id="blog-select-all"></th><th>Cím</th><th>Kategória</th><th>Státusz</th><th>Megtekintés</th><th>Dátum</th><th></th></tr></thead>
                        <tbody>
                            <% blogPosts.forEach(p => { %>
                            <tr>
                                <td><input type="checkbox" name="ids" value="<%= p.id %>" form="bulk-blog-form" class="blog-checkbox"></td>
                                <td class="fw-bold"><%= p.title %></td>
                                <td class="text-muted"><%= p.category || '-' %></td>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <td><span class="message-status <%= p.status === 'published' ? 'read' : 'new' %>"><%= p.status === 'published' ? 'Publikus' : 'Piszkozat' %></span></td>
                                <td class="text-muted"><%= p.views || 0 %></td>
                                <td class="text-muted small"><%= p.created_at ? new Date(p.created_at).toLocaleDateString('hu-HU') : '' %></td>
                                <td class="text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-warning me-1" data-bs-toggle="modal" data-bs-target="#blogEditModal"
                                        data-id="<%= p.id %>"
                                        data-title='<%= (p.title || '').replace(/'/g, "&#39;") %>'
                                        data-slug='<%= (p.slug || '').replace(/'/g, "&#39;") %>'
                                        data-category='<%= (p.category || '').replace(/'/g, "&#39;") %>'
                                        data-cover='<%= (p.cover || '').replace(/'/g, "&#39;") %>'
                                        data-excerpt='<%= (p.excerpt || '').replace(/'/g, "&#39;") %>'
                                        data-content='<%= (p.content || '').replace(/'/g, "&#39;").replace(/"/g, "&#34;") %>'
                                        data-status="<%= p.status %>"
                                        title="Szerkesztés"><i class="fa-solid fa-pen"></i></button>
                                    <form action="/admin/blog-delete/<%= p.id %>" method="POST" data-confirm="Biztosan törli?" style="display:inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                            <% if (!blogPosts.length) { %><tr><td colspan="6" class="text-center py-4 text-muted">Még nincsenek blog bejegyzések.</td></tr><% } %>
                        </tbody>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    </table>
                </div>
            </div>

            <!-- Blog létrehozás modal -->
            <div class="modal fade" id="blogCreateModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content">
                <div class="modal-header"><h5 class="modal-title"><i class="fa-solid fa-pen-nib me-2"></i> Új blog bejegyzés</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <form action="/admin/blog-create" method="POST" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label">Cím *</label><input type="text" name="title" class="form-control" required></div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6"><label class="form-label">Slug</label><input type="text" name="slug" class="form-control" placeholder="Automatikusan generálva"></div>
                        <div class="col-md-6"><label class="form-label">Kategória</label><input type="text" name="category" class="form-control" placeholder="pl. Tippek, Inspiráció"></div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6"><label class="form-label">Borítókép feltöltése saját gépről</label><input type="file" name="cover_file" class="form-control" accept="image/*"></div>
                        <div class="col-md-6"><label class="form-label">VAGY Borítókép URL / elérési út</label><input type="text" name="cover" class="form-control" placeholder="/uploads/... vagy https://..."></div>
                    </div>
                    <div class="mb-3"><label class="form-label">Kivonat</label><textarea name="excerpt" class="form-control" rows="2" placeholder="Rövid összefoglaló..."></textarea></div>
                    <div class="mb-3"><label class="form-label">Tartalom</label><textarea name="content" id="blog_new_content" class="form-control" rows="10" placeholder="A blog bejegyzés teljes szövege..."></textarea></div>
                    <div class="mb-3"><label class="form-label">Státusz</label><select name="status" class="form-select"><option value="draft">Piszkozat</option><option value="published">Publikus</option></select></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Mégse</button><button type="submit" class="btn btn-wood"><i class="fa-solid fa-save me-2"></i> Mentés</button></div>
                </form>
            </div></div></div>

            <!-- Blog szerkesztés modal -->
            <div class="modal fade" id="blogEditModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content">
                <div class="modal-header"><h5 class="modal-title"><i class="fa-solid fa-pen me-2"></i> Blog bejegyzés szerkesztése</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <form action="/admin/blog-update/" method="POST" id="blogEditForm" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label">Cím *</label><input type="text" name="title" id="edit_blog_title" class="form-control" required></div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6"><label class="form-label">Slug</label><input type="text" name="slug" id="edit_blog_slug" class="form-control" placeholder="Automatikusan generálva"></div>
                        <div class="col-md-6"><label class="form-label">Kategória</label><input type="text" name="category" id="edit_blog_category" class="form-control" placeholder="pl. Tippek, Inspiráció"></div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6"><label class="form-label">Új borítókép feltöltése saját gépről</label><input type="file" name="cover_file" class="form-control" accept="image/*"></div>
                        <div class="col-md-6"><label class="form-label">Jelenlegi kép URL / elérési út</label><input type="text" name="cover" id="edit_blog_cover" class="form-control" placeholder="/uploads/... vagy https://..."></div>
                    </div>
                    <div class="mb-3"><label class="form-label">Kivonat</label><textarea name="excerpt" id="edit_blog_excerpt" class="form-control" rows="2" placeholder="Rövid összefoglaló..."></textarea></div>
                    <div class="mb-3"><label class="form-label">Tartalom</label><textarea name="content" id="edit_blog_content" class="form-control" rows="10" placeholder="A blog bejegyzés teljes szövege..."></textarea></div>
                    <div class="mb-3"><label class="form-label">Státusz</label><select name="status" id="edit_blog_status" class="form-select"><option value="draft">Piszkozat</option><option value="published">Publikus</option></select></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Mégse</button><button type="submit" class="btn btn-wood"><i class="fa-solid fa-save me-2"></i> Módosítások mentése</button></div>
                </form>
            </div></div></div>
            <% } %>

            <!-- ANALYTICS TAB -->
            <% if(tab == 'analytics') { %>
            <h3 class="fw-bold mb-4 text-white"><i class="fa-solid fa-chart-line me-2" style="color:var(--gold)"></i> Analytics</h3>
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="summary-card"><span class="summary-label">Összes megtekintés</span><strong><%= analytics.totalViews %></strong><small>Mindösszesen</small></div>
                </div>
                <div class="col-md-3">
                    <div class="summary-card"><span class="summary-label">Mai megtekintések</span><strong><%= analytics.todayViews %></strong><small>Ma</small></div>
                </div>
                <div class="col-md-3">
                    <div class="summary-card"><span class="summary-label">Egyedi látogatók</span><strong><%= analytics.uniqueVisitors %></strong><small>IP alapján</small></div>
                </div>
                <div class="col-md-3">
                    <div class="summary-card"><span class="summary-label">Blog megtekintések</span><strong><%= blogPosts.reduce((a, b) => a + (b.views || 0), 0) %></strong><small>Összesen</small></div>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                </div>
            </div>

            <% if (analytics.topPages && analytics.topPages.length > 0) { %>
            <div class="card mb-4">
                <div class="card-header"><i class="fa-solid fa-fire me-2"></i> Legnépszerűbb oldalak</div>
                <div class="card-body">
                    <% analytics.topPages.forEach((p, i) => { %>
                    <div class="d-flex justify-content-between align-items-center py-2 <%= i > 0 ? 'border-top' : '' %>" style="border-color:rgba(212,176,107,0.1) !important">
                        <span><i class="fa-solid fa-arrow-right me-2" style="color:var(--gold);font-size:0.7rem"></i> <%= p.page %></span>
                        <span class="fw-bold" style="color:var(--gold)"><%= p.views %> <small class="text-muted">megtekintés</small></span>
                    </div>
                    <% }) %>
                </div>
            </div>
            <% } %>

            <% if (analytics.dailyViews && analytics.dailyViews.length > 0) { %>
            <div class="card">
                <div class="card-header"><i class="fa-solid fa-calendar-days me-2"></i> Napi megtekintések (utolsó 30 nap)</div>
                <div class="card-body">
                    <div style="display:flex;align-items:flex-end;gap:4px;height:120px;">
                        <% const maxDaily = Math.max(...analytics.dailyViews.map(d => d.views)); %>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <% analytics.dailyViews.reverse().forEach(d => { %>
                        <div style="flex:1;background:#d7b36a;border-radius:4px 4px 0 0;height:<%= maxDaily ? Math.max(8, (d.views / maxDaily) * 100) : 8 %>%;opacity:0.7" title="<%= d.date %>: <%= d.views %>"></div>
                        <% }) %>
                    </div>
                    <div class="text-muted small mt-2 text-center">← Régebbiek — Mai nap →</div>
                </div>
            </div>
            <% } %>
            <% } %>

            <!-- HÍRLEVÉL TAB -->
            <% if(tab == 'newsletter') { %>
            <h3 class="fw-bold mb-4 text-white"><i class="fa-solid fa-paper-plane me-2" style="color:var(--gold)"></i> Hírlevél kezelés</h3>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="summary-card"><span class="summary-label">Feliratkozók</span><strong><%= newsletterCount %></strong><small>Aktív feliratkozás</small></div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><i class="fa-solid fa-paper-plane me-2"></i> Hírlevél küldése</div>
