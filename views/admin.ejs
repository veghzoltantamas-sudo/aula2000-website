                <% if (mediaFiles && mediaFiles.length > 0) { %>
                    <% mediaFiles.forEach(file => { %>
                        <div class="col-md-3 col-lg-2">
                            <div class="card bg-dark text-white p-2 h-100 shadow-sm border-secondary">
                                <img src="/uploads/<%= file.name %>" class="img-fluid rounded" style="height: 120px; width: 100%; object-fit: cover; cursor: pointer;" onclick="window.open('/uploads/<%= file.name %>', '_blank')">
                                <div class="small text-truncate mt-2" title="<%= file.name %>"><%= file.name %></div>
                                <div class="text-muted" style="font-size: 0.7rem;"><%= (file.size / 1024).toFixed(1) %> KB</div>
                                <div class="mt-auto pt-2">
                                    <form action="/admin/media/delete" method="POST" onsubmit="return confirm('Biztosan törlöd ezt a fájlt?');">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="filename" value="<%= file.name %>">
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100"><i class="fa-solid fa-trash me-1"></i> Törlés</button>
