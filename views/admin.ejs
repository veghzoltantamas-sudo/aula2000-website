                                    <label class="form-label small">Típus</label>
                                    <input type="text" name="type" class="form-control" value="HomeAndConstructionBusiness" placeholder="HomeAndConstructionBusiness">
                                </div>
                                <div class="col-12">
                                    <label class="form-label small d-flex justify-content-between align-items-center"><span>JSON-LD adatok</span><span class="json-status" id="schema-add-status"></span></label>
                                    <div class="html-toolbar" data-for="schema-add-json">
                                        <button type="button" class="btn btn-sm btn-outline-light" data-action="json-format" title="JSON formázás"><i class="fa-solid fa-code me-1"></i> Formázás</button>
                                        <button type="button" class="btn btn-sm btn-outline-light" data-action="json-validate" title="JSON ellenőrzés"><i class="fa-solid fa-check me-1"></i> Ellenőrzés</button>
                                        <button type="button" class="btn btn-sm btn-outline-warning" data-action="json-tmpl-local" title="LocalBusiness sablon">LocalBusiness</button>
                                        <button type="button" class="btn btn-sm btn-outline-warning" data-action="json-tmpl-faq" title="FAQ sablon">FAQ</button>
                                        <button type="button" class="btn btn-sm btn-outline-warning" data-action="json-tmpl-breadcrumb" title="Breadcrumb sablon">Breadcrumb</button>
                                    </div>
                                    <textarea name="data_json" id="schema-add-json" class="form-control html-source" rows="14" placeholder='{"@context": "https://schema.org", "@type": "LocalBusiness", "name": "Aula 2000"}' required></textarea>
                                </div>
                                <div class="col-12">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" name="is_active" checked>
                                        <label class="form-check-label text-muted small">Publikus / aktív</label>
                                    </div>
                                </div>
                                <div class="col-12 text-end">
                                    <button type="submit" class="btn btn-wood"><i class="fa-solid fa-save me-2"></i> Mentés</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
