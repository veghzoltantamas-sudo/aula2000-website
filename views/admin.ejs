                                    <div class="workflow-gallery-strip">
                                        <% workflowGallery.forEach(function(image, imageIndex) { %>
                                        <div class="workflow-gallery-item">
                                            <img src="<%= image.startsWith('http') ? image : '/uploads/' + image %>" alt="<%= item.title %> galériakép <%= imageIndex + 1 %>" loading="lazy" width="72" height="48">
                                            <form action="/admin/workflows/<%= item.id %>/gallery-delete" method="POST" data-confirm="Törlöd ezt a galériaképet?">
