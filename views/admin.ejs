                    <form action="/admin/newsletter-send" method="POST" data-confirm="Biztosan elküldi a hírlevelet <%= newsletterCount %> feliratkozónak?">
                        <div class="mb-3"><label class="form-label">Tárgy</label><input type="text" name="subject" class="form-control" placeholder="Hírlevél tárgya..." required></div>
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center"><span>Tartalom (HTML támogatott)</span><button type="button" class="btn btn-sm btn-outline-secondary html-preview-toggle" data-target="newsletter-body"><i class="fa-solid fa-eye me-1"></i> Előnézet</button></label>
                            <div class="html-toolbar" data-for="newsletter-body">
                                <button type="button" class="btn btn-sm btn-outline-light" data-action="bold" title="Félkövér"><i class="fa-solid fa-bold"></i></button>
                                <button type="button" class="btn btn-sm btn-outline-light" data-action="italic" title="Dőlt"><i class="fa-solid fa-italic"></i></button>
                                <button type="button" class="btn btn-sm btn-outline-light" data-action="h2" title="Cím"><i class="fa-solid fa-heading"></i></button>
                                <button type="button" class="btn btn-sm btn-outline-light" data-action="p" title="Bekezdés"><i class="fa-solid fa-paragraph"></i></button>
                                <button type="button" class="btn btn-sm btn-outline-light" data-action="link" title="Link"><i class="fa-solid fa-link"></i></button>
                                <button type="button" class="btn btn-sm btn-outline-light" data-action="ul" title="Felsorolás"><i class="fa-solid fa-list-ul"></i></button>
                                <button type="button" class="btn btn-sm btn-outline-light" data-action="img" title="Kép"><i class="fa-solid fa-image"></i></button>
                                <button type="button" class="btn btn-sm btn-outline-light" data-action="quote" title="Idézet"><i class="fa-solid fa-quote-left"></i></button>
                                <button type="button" class="btn btn-sm btn-outline-light" data-action="hr" title="Elválasztó"><i class="fa-solid fa-minus"></i></button>
                                <button type="button" class="btn btn-sm btn-warning" data-action="convert" title="Sima szöveg → HTML"><i class="fa-solid fa-wand-magic-sparkles me-1"></i> Szöveg → HTML</button>
                            </div>
                            <textarea name="body" id="newsletter-body" class="form-control html-source" rows="8" placeholder="<h2>Cím</h2><p>Szöveg...</p>" required></textarea>
                            <div class="html-convert-hint">Sima szöveg beillesztése után: <strong>Szöveg → HTML</strong>. Támogat: *|NAME|*, *|EMAIL|*, *|UNSUB|*.</div>
                            <div class="html-preview mt-2 d-none" id="preview-newsletter-body"></div>
                        </div>
                        <button type="submit" class="btn btn-wood"><i class="fa-solid fa-paper-plane me-2"></i> Küldés <%= newsletterCount %> feliratkozónak</button>
                    </form>
                </div>
            </div>

            <div class="card p-0">
                <div class="card-header"><i class="fa-solid fa-users me-2"></i> Feliratkozók listája</div>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead><tr><th>Email</th><th>Feliratkozás időpontja</th><th></th></tr></thead>
                        <tbody>
                            <% newsletterSubscribers.forEach(s => { %>
                            <tr>
                                <td class="fw-bold"><%= s.email %></td>
                                <td class="text-muted small"><%= s.subscribed_at ? new Date(s.subscribed_at).toLocaleDateString('hu-HU') : '' %></td>
                                <td>
                                    <form action="/admin/newsletter-delete/<%= s.id %>" method="POST" data-confirm="Biztosan törli?" style="display:inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                            <% if (!newsletterSubscribers.length) { %><tr><td colspan="3" class="text-center py-4 text-muted">Még nincsenek feliratkozók.</td></tr><% } %>
                        </tbody>
                    </table>
                </div>
            </div>
            <% } %>

            <!-- ÜZENETEK TAB -->
            <% if(tab == 'messages') { %>
            <h3 class="fw-bold mb-4 text-white">Ajánlatkérések</h3>
            <% if (unreadMessages > 0) { %>
            <div class="alert alert-success mb-4">
                <i class="fa-solid fa-bell me-2"></i> <strong><%= unreadMessages %></strong> új, olvasatlan bejövő kérés érkezett a rendszerbe.
            </div>
            <% } %>
            <form id="bulk-messages-form" action="/admin/bulk-messages" method="POST" class="card card-body mb-3">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <strong class="me-2">Kijelöltek:</strong>
                    <select name="action" class="form-select form-select-sm" style="max-width:220px" aria-label="Tömeges művelet">
                        <option value="read">Olvasottnak jelölés</option>
                        <option value="delete">Törlés</option>
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-light">Művelet végrehajtása</button>
                </div>
            </form>
            <div class="card p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th><span class="visually-hidden">Kijelölés</span></th><th>Dátum</th><th>Név</th><th>E-mail / Telefon</th><th>Üzenet</th><th>Állapot</th><th></th></tr></thead>
                        <tbody>
                            <% messages.forEach(m => { %>
                            <tr>
                                <td><input type="checkbox" name="ids" value="<%= m.id %>" form="bulk-messages-form" aria-label="<%= m.name %> kijelölése"></td>
                                <td class="text-muted small"><%= m.date %></td>
                                <td class="fw-bold"><%= m.name %></td>
                                <td><a href="mailto:<%= m.email %>" class="text-decoration-none"><%= m.email %></a><br><span class="text-muted small"><%= m.phone %></span></td>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <td style="max-width: 300px;"><%= m.message %></td>
                                <td>
                                    <div class="d-flex flex-column gap-2 align-items-start">
                                        <span class="message-status <%= m.status %>"><%= m.statusLabel %></span>
                                        <form action="/admin/update-msg-status/<%= m.id %>" method="POST" class="d-flex gap-2 align-items-center">
                                            <select name="status" class="form-select form-select-sm bg-dark text-white border-secondary" aria-label="Üzenet státusz">
                                                <option value="new" <%= m.status === 'new' ? 'selected' : '' %>>Olvasatlan</option>
                                                <option value="read" <%= m.status === 'read' ? 'selected' : '' %>>Olvasott</option>
                                                <option value="important" <%= m.status === 'important' ? 'selected' : '' %>>Fontos</option>
                                            </select>
                                            <button type="submit" class="btn btn-sm btn-outline-light">Mentés</button>
                                        </form>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-info reply-email-btn" data-bs-toggle="modal" data-bs-target="#replyEmailModal" data-email="<%= m.email %>" data-name="<%= m.name %>" data-message="<%= m.message %>"><i class="fa-solid fa-reply"></i></button>
                                    <form action="/admin/del-msg/<%= m.id %>" method="POST" data-confirm="Törlés">
                                        <button type="submit" class="btn btn-sm btn-light text-danger"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                            <% if(messages.length === 0) { %><tr><td colspan="7" class="text-center py-5 text-muted">Nincs beérkezett üzenet.</td></tr><% } %>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        </tbody>
                    </table>
                </div>
                <% if(typeof totalMessagePages !== 'undefined' && totalMessagePages > 1) { %>
                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-secondary">
                    <small class="text-muted">Összesen: <%= totalMessages %> üzenet (<%= msgPage %> / <%= totalMessagePages %> oldal)</small>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item <%= msgPage <= 1 ? 'disabled' : '' %>">
                                <a class="page-link bg-dark text-white border-secondary" href="?tab=messages&msgPage=<%= msgPage - 1 %>">&laquo; Előző</a>
                            </li>
                            <% for(let p = 1; p <= totalMessagePages; p++) { %>
                                <% if(p === 1 || p === totalMessagePages || (p >= msgPage - 2 && p <= msgPage + 2)) { %>
                                    <li class="page-item <%= p === msgPage ? 'active' : '' %>">
                                        <a class="page-link <%= p === msgPage ? 'bg-primary text-white border-primary' : 'bg-dark text-white border-secondary' %>" href="?tab=messages&msgPage=<%= p %>"><%= p %></a>
                                    </li>
                                <% } else if(p === msgPage - 3 || p === msgPage + 3) { %>
                                    <li class="page-item disabled"><span class="page-link bg-dark text-muted border-secondary">...</span></li>
                                <% } %>
                            <% } %>
                            <li class="page-item <%= msgPage >= totalMessagePages ? 'disabled' : '' %>">
                                <a class="page-link bg-dark text-white border-secondary" href="?tab=messages&msgPage=<%= msgPage + 1 %>">Következő &raquo;</a>
                            </li>
                        </ul>
                    </nav>
                </div>
                <% } %>
            </div>
            <div class="modal fade" id="replyEmailModal" tabindex="-1" data-bs-theme="dark">
                <div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content bg-dark text-white">
                    <div class="modal-header border-secondary"><h5 class="modal-title"><i class="fa-solid fa-reply me-2 text-info"></i> Válasz küldése</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
                    <form action="/admin/send-email" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="modal-body"><div class="row g-3">
                            <div class="col-md-6"><label class="form-label">Címzett</label><input id="replyEmailTo" type="email" name="to" class="form-control" required readonly></div>
                            <div class="col-md-6"><label class="form-label">Sablon</label><select id="replyEmailTemplate" class="form-select"><option value="">Egyedi válasz</option><% (emailTemplates || []).forEach(t => { %><option value="<%= t.id %>" data-subject="<%= t.subject || '' %>" data-body="<%= t.body || '' %>"><%= t.name %></option><% }) %></select></div>
                            <div class="col-12"><label class="form-label">Tárgy</label><input id="replyEmailSubject" type="text" name="subject" class="form-control" maxlength="200" required></div>
                            <div class="col-12"><label class="form-label">Üzenet (HTML)</label><textarea id="replyEmailBody" name="body" class="form-control" rows="12" required></textarea><small class="text-muted">Használható változók: *|NAME|*, *|EMAIL|*, *|MESSAGE|*.</small></div>
                        </div></div>
                        <div class="modal-footer border-secondary"><button type="submit" class="btn btn-wood"><i class="fa-solid fa-paper-plane me-2"></i> Küldés</button></div>
                    </form>
                </div></div>
            </div>
            <% } %>

            <% if(tab == 'logs') { %>
            <h3 class="fw-bold mb-4 text-white"><i class="fa-solid fa-scroll me-2" style="color:var(--gold)"></i> Tevékenység napló</h3>
            <div class="row g-2 mb-4">
                <div class="col-auto">
                    <a href="?tab=logs&logFilter=all" class="btn btn-sm <%= logFilter === 'all' ? 'btn-wood' : 'btn-outline-wood' %>">Összes</a>
                    <a href="?tab=logs&logFilter=error" class="btn btn-sm <%= logFilter === 'error' ? 'btn-outline-danger' : 'btn-outline-secondary' %>">❌ Hibák</a>
                    <a href="?tab=logs&logFilter=upload" class="btn btn-sm <%= logFilter === 'upload' ? 'btn-outline-info' : 'btn-outline-secondary' %>">📤 Feltöltések</a>
                    <a href="?tab=logs&logFilter=warn" class="btn btn-sm <%= logFilter === 'warn' ? 'btn-outline-warning' : 'btn-outline-secondary' %>">⚠️ Figyelmeztetések</a>
                    <form action="/admin/clear-logs" method="POST" class="d-inline" data-confirm="Biztosan törlöd ÖSSZES napló bejegyzést? Ez nem visszavonható!">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-sm btn-outline-danger">🗑️ Mindent törlés</button>
                    </form>
                </div>
            </div>
            <form method="GET" action="/admin" class="row g-2 mb-3 admin-filter-form">
                <input type="hidden" name="tab" value="logs">
                <div class="col-sm-6 col-lg-5"><input type="search" name="logSearch" value="<%= typeof logSearch !== 'undefined' ? logSearch : '' %>" class="form-control" placeholder="Keresés műveletben, URL-ben vagy üzenetben" aria-label="Napló keresése"></div>
                <div class="col-sm-3 col-lg-2"><select name="logStatus" class="form-select" aria-label="HTTP státusz"><option value="">Minden státusz</option><option value="200" <%= typeof logStatus !== 'undefined' && logStatus === '200' ? 'selected' : '' %>>200</option><option value="302" <%= typeof logStatus !== 'undefined' && logStatus === '302' ? 'selected' : '' %>>302</option><option value="400" <%= typeof logStatus !== 'undefined' && logStatus === '400' ? 'selected' : '' %>>400</option><option value="403" <%= typeof logStatus !== 'undefined' && logStatus === '403' ? 'selected' : '' %>>403</option><option value="404" <%= typeof logStatus !== 'undefined' && logStatus === '404' ? 'selected' : '' %>>404</option><option value="500" <%= typeof logStatus !== 'undefined' && logStatus === '500' ? 'selected' : '' %>>500</option></select></div>
                <div class="col-sm-3 col-lg-2"><button class="btn btn-outline-light w-100" type="submit"><i class="fa-solid fa-filter me-1"></i> Szűrés</button></div>
            </form>
            <div class="card p-0">
                <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light"><tr><th>Időpont</th><th>Szint</th><th>Tevékenység</th><th>Metódus</th><th>URL</th><th>Státusz</th><th>Üzenet / Hiba</th><th>Idő (ms)</th></tr></thead>
                        <tbody>
                            <% (activityLogs || []).forEach(log => { %>
                            <tr class="table-<%= log.levelClass %>">
                                <td class="text-muted small" title="<%= log.ts %>"><%= log.ts ? log.ts.slice(11, 19) : '-' %></td>
                                <td><span class="badge bg-<%= log.levelClass %>"><i class="fa-solid <%= log.levelIcon %>"></i> <%= log.level %></span></td>
                                <td><strong><%= log.action %></strong></td>
                                <td><code><%= log.method %></code></td>
                                <td style="max-width: 250px; word-break: break-all;"><small><%= log.url %></small></td>
                                <td><code><strong><%= log.status %></strong></code></td>
                                <td style="max-width: 300px;"><small><%= log.message %></small><% if (log.details) { %><br><code style="font-size: 0.75rem; opacity: 0.7;">Részletek: <%= typeof log.details === 'string' ? log.details.slice(0, 100) : JSON.stringify(log.details).slice(0, 100) %></code><% } %></td>
                                <td class="text-end"><small><strong><%= log.duration_ms ? Math.round(log.duration_ms) : '-' %></strong></small></td>
                                <td>
                                    <form action="/admin/del-log/<%= log.id %>" method="POST" data-confirm="Biztosan törlöd ezt a napló bejegyzést?" style="display:inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" style="padding: 2px 6px;"><i class="fa-solid fa-trash me-1"></i>Törlés</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                            <% if (!activityLogs || activityLogs.length === 0) { %>
                            <tr><td colspan="8" class="text-center py-5 text-muted">Nincs napló bejegyzés.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
                <% if(typeof totalLogPages !== 'undefined' && totalLogPages > 1) { %>
                <% const logQueryParams = `tab=logs&logFilter=${encodeURIComponent(logFilter || 'all')}&logStatus=${encodeURIComponent(logStatus || '')}&logSearch=${encodeURIComponent(logSearch || '')}`; %>
                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-secondary">
                    <small class="text-muted">Összesen: <%= totalLogs %> napló bejegyzés (<%= logPage %> / <%= totalLogPages %> oldal)</small>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item <%= logPage <= 1 ? 'disabled' : '' %>">
                                <a class="page-link bg-dark text-white border-secondary" href="?<%= logQueryParams %>&logPage=<%= logPage - 1 %>">&laquo; Előző</a>
                            </li>
                            <% for(let p = 1; p <= totalLogPages; p++) { %>
                                <% if(p === 1 || p === totalLogPages || (p >= logPage - 2 && p <= logPage + 2)) { %>
                                    <li class="page-item <%= p === logPage ? 'active' : '' %>">
                                        <a class="page-link <%= p === logPage ? 'bg-primary text-white border-primary' : 'bg-dark text-white border-secondary' %>" href="?<%= logQueryParams %>&logPage=<%= p %>"><%= p %></a>
                                    </li>
                                <% } else if(p === logPage - 3 || p === logPage + 3) { %>
                                    <li class="page-item disabled"><span class="page-link bg-dark text-muted border-secondary">...</span></li>
                                <% } %>
                            <% } %>
                            <li class="page-item <%= logPage >= totalLogPages ? 'disabled' : '' %>">
                                <a class="page-link bg-dark text-white border-secondary" href="?<%= logQueryParams %>&logPage=<%= logPage + 1 %>">Következő &raquo;</a>
                            </li>
                        </ul>
                    </nav>
                </div>
                <% } %>
            </div>
            <% } %>

            <!-- PARTNEREK TAB -->
            <% if(tab == 'partners') { %>
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="fa-solid fa-handshake me-2 text-warning"></i> Partnerek</h5>
                    <button class="btn btn-sm btn-wood" data-bs-toggle="modal" data-bs-target="#addPartnerModal"><i class="fa-solid fa-plus me-1"></i> Új partner</button>
                </div>
                <div class="card-body">
                    <div class="row g-3 partners-sortable">
