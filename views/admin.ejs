                <h3 class="fw-bold m-0 text-white">Szolgáltatások Kezelése</h3>
                <button class="btn btn-wood px-4" data-bs-toggle="modal" data-bs-target="#addServiceModal"><i class="fa-solid fa-plus me-2"></i> Új Szolgáltatás Hozzáadása</button>
            </div>

            <div class="service-admin-toolbar" aria-label="Szolgáltatások szűrése">
                <div class="service-admin-summary">
                    <span class="service-admin-kicker">Katalógus</span>
                    <strong><span id="serviceVisibleCount"><%= services ? services.length : 0 %></span> szolgáltatás</strong>
                    <span class="service-admin-meta"><%= services ? services.filter(item => item.is_active).length : 0 %> aktív, <%= services ? services.filter(item => !item.is_active).length : 0 %> rejtett</span>
                </div>
                <div class="service-admin-controls">
                    <label class="service-admin-search">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <span class="visually-hidden">Szolgáltatás keresése</span>
                        <input type="search" id="serviceAdminSearch" placeholder="Keresés név vagy slug alapján" autocomplete="off">
                    </label>
                    <div class="filter-toolbar service-status-filters mb-0" data-filter-group="services">
                        <button type="button" class="filter-pill active" data-service-status="all">Összes</button>
                        <button type="button" class="filter-pill" data-service-status="active">Aktív</button>
                        <button type="button" class="filter-pill" data-service-status="inactive">Rejtett</button>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4" id="serviceAdminGrid">
                <% if (typeof services !== 'undefined' && services && services.length > 0) { %>
                    <% services.forEach(function(item) { %>
                        <% let serviceGallery = []; try { serviceGallery = JSON.parse(item.gallery_images || '[]'); } catch (error) { serviceGallery = []; } %>
                        <div class="col-xl-4 service-admin-item" data-service-status="<%= item.is_active ? 'active' : 'inactive' %>" data-service-search="<%= (item.title + ' ' + (item.slug || '') + ' ' + (item.short_desc || '')).toLowerCase().replace(/"/g, '&quot;') %>">
                            <div class="card service-admin-card bg-dark text-white border-secondary h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex gap-3 align-items-start">
                                        <div class="service-admin-thumb flex-shrink-0">
                                            <% if (item.image) { %>
                                                <img src="<%= item.image.startsWith('http') ? item.image : '/uploads/' + item.image %>" alt="<%= item.title %>" class="rounded object-fit-cover border border-secondary">
                                            <% } else { %>
                                                <div class="service-admin-icon d-flex align-items-center justify-content-center rounded border border-secondary bg-secondary-subtle">
                                                    <i class="<%= item.icon || 'fa-solid fa-image' %>"></i>
                                                </div>
                                            <% } %>
                                        </div>
                                        <div class="flex-grow-1 min-width-0">
                                            <div class="d-flex justify-content-between align-items-start gap-2">
                                                <div>
                                                    <div class="small text-warning fw-semibold mb-1">#<%= item.id %></div>
                                                    <h5 class="mb-1 text-white"><%= item.title %></h5>
                                                </div>
                                                <% if (item.is_active) { %>
                                                    <span class="badge bg-success">Aktív</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">Inaktív</span>
                                                <% } %>
                                            </div>
                                            <div class="small text-muted mb-2">Slug: /szolgaltatasok/<%= item.slug %></div>
                                            <p class="text-light-emphasis small mb-2"><%= item.short_desc || 'Nincs rövid leírás.' %></p>
                                            <div class="d-flex flex-wrap gap-2 small text-muted">
                                                <span class="badge bg-dark border border-secondary">Sorrend: <%= item.sort_order %></span>
                                                <span class="badge bg-dark border border-secondary">Ikon: <%= item.icon || 'fa-solid fa-image' %></span>
                                            </div>
                                            <div class="small text-warning fw-bold mt-2"><i class="fa-solid fa-images me-1"></i> Galéria: <%= serviceGallery.length %> kép</div>
                                        </div>
                                    </div>

                                    <% if (serviceGallery.length) { %>
                                    <div class="service-gallery-strip mt-3">
                                        <% serviceGallery.forEach(function(image, imageIndex) { %>
                                        <div class="workflow-gallery-item">
                                            <img src="<%= image.startsWith('http') ? image : '/uploads/' + image %>" alt="<%= item.title %> galériakép <%= imageIndex + 1 %>" loading="lazy" width="72" height="48">
                                            <form action="/admin/services/<%= item.id %>/gallery-delete" method="POST" data-confirm="Törlöd ezt a szolgáltatásképet?">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="image_index" value="<%= imageIndex %>">
                                                <button type="submit" title="Szolgáltatás kép törlése" aria-label="Szolgáltatás kép törlése"><i class="fa-solid fa-xmark"></i></button>
                                            </form>
                                        </div>
                                        <% }) %>
                                    </div>
                                    <% } %>
                                    <form action="/admin/services/<%= item.id %>/gallery-add" method="POST" enctype="multipart/form-data" class="service-gallery-add mt-2">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="file" name="service_gallery_image" accept="image/*" required>
                                        <button type="submit" class="btn btn-sm btn-outline-warning"><i class="fa-solid fa-plus me-1"></i> Kép hozzáadása</button>
                                    </form>

                                    <div class="mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2 border-top border-secondary pt-3">
                                        <a href="/szolgaltatasok/<%= item.slug %>" class="btn btn-sm btn-outline-light" target="_blank" rel="noopener">
                                            <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Előnézet
                                        </a>

                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-warning service-edit-btn"
                                                data-service-edit
                                                data-id="<%= item.id %>"
                                                data-title="<%= item.title.replace(/"/g, '&quot;') %>"
                                                data-slug="<%= (item.slug || '').replace(/"/g, '&quot;') %>"
                                                data-short_desc="<%= (item.short_desc || '').replace(/"/g, '&quot;') %>"
                                                data-description="<%= (item.description || '').replace(/"/g, '&quot;').replace(/\n/g, '&#10;') %>"
                                                data-icon="<%= (item.icon || '').replace(/"/g, '&quot;') %>"
                                                data-sort_order="<%= item.sort_order %>"
                                                data-is_active="<%= item.is_active %>"
                                            >
                                                <i class="fa-solid fa-pen me-1"></i> Szerkesztés
                                            </button>

                                            <form action="/admin/services/delete/<%= item.id %>" method="POST" class="d-inline" data-confirm="Biztosan törlöd ezt a szolgáltatást?">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Törlés">
                                                    <i class="fa-solid fa-trash me-1"></i> Törlés
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-12 service-admin-empty">
                        <div class="card bg-dark text-white border-secondary">
                            <div class="card-body text-center text-muted py-5">Nincs még hozzáadva szolgáltatás.</div>
                        </div>
                    </div>
                <% } %>
            </div>
            <div id="serviceAdminNoResults" class="service-admin-no-results d-none">
                <i class="fa-solid fa-filter-circle-xmark" aria-hidden="true"></i>
                <strong>Nincs ilyen szolgáltatás</strong>
                <span>Próbálj másik keresőkifejezést vagy szűrőt.</span>
            </div>

            <!-- Új Szolgáltatás Modal -->
            <div class="modal fade" id="addServiceModal" tabindex="-1">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content bg-dark text-white border-secondary">
                        <form action="/admin/services/create" method="POST" enctype="multipart/form-data">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="modal-header border-secondary">
                                <h5 class="modal-title text-white">Új szolgáltatás hozzáadása</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Szolgáltatás megnevezése (Cím) <span class="text-danger">*</span></label>
                                        <input type="text" name="title" class="form-control bg-dark text-white border-secondary" required>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Slug (URL)</label>
                                        <input type="text" name="slug" class="form-control bg-dark text-white border-secondary" placeholder="egyedi-konyhabutor">
                                    </div>
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label">Ikon (FontAwesome class pl: fa-solid fa-pencil-ruler)</label>
                                        <input type="text" name="icon" class="form-control bg-dark text-white border-secondary" placeholder="fa-solid fa-check">
                                    </div>
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label">Rövid leírás (Kezdőlapra)</label>
                                        <textarea name="short_desc" class="form-control bg-dark text-white border-secondary" rows="2" maxlength="255"></textarea>
                                    </div>
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label">Részletes leírás (Szolgáltatás oldalra) (HTML engedélyezett)</label>
                                        <textarea name="description" class="form-control bg-dark text-white border-secondary" rows="6"></textarea>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Főkép (1600x1200 / 1200x800 arány javasolt)</label>
                                        <input type="file" name="service_image" class="form-control bg-dark text-white border-secondary" accept="image/*">
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label class="form-label">Sorrend</label>
                                        <input type="number" name="sort_order" class="form-control bg-dark text-white border-secondary" value="0">
                                    </div>
                                    <div class="col-md-3 mb-3 d-flex align-items-end">
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input bg-dark border-secondary" type="checkbox" name="is_active" id="is_active_new" checked>
                                            <label class="form-check-label" for="is_active_new">Aktív (Publikus)</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer border-secondary">
                                <button type="submit" class="btn btn-warning text-dark"><i class="fa-solid fa-save me-1"></i> Létrehozás</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Szolgáltatás Szerkesztés Modal -->
            <div class="modal fade" id="editServiceModal" tabindex="-1">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content bg-dark text-white border-secondary">
                        <form id="editServiceForm" action="" method="POST" enctype="multipart/form-data">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="id" id="edit_service_id">
                            <div class="modal-header border-secondary">
                                <h5 class="modal-title text-white">Szolgáltatás szerkesztése</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Szolgáltatás megnevezése (Cím) <span class="text-danger">*</span></label>
                                        <input type="text" name="title" id="edit_service_title" class="form-control bg-dark text-white border-secondary" required>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Slug (URL)</label>
                                        <input type="text" name="slug" id="edit_service_slug" class="form-control bg-dark text-white border-secondary">
                                    </div>
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label">Ikon (FontAwesome class)</label>
                                        <input type="text" name="icon" id="edit_service_icon" class="form-control bg-dark text-white border-secondary">
                                    </div>
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label">Rövid leírás</label>
                                        <textarea name="short_desc" id="edit_service_short_desc" class="form-control bg-dark text-white border-secondary" rows="2" maxlength="255"></textarea>
                                    </div>
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label">Részletes leírás (HTML)</label>
                                        <textarea name="description" id="edit_service_description" class="form-control bg-dark text-white border-secondary" rows="6"></textarea>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Új kép (Ha üres, marad a régi)</label>
                                        <input type="file" name="service_image" class="form-control bg-dark text-white border-secondary" accept="image/*">
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label class="form-label">Sorrend</label>
                                        <input type="number" name="sort_order" id="edit_service_sort_order" class="form-control bg-dark text-white border-secondary">
                                    </div>
                                    <div class="col-md-3 mb-3 d-flex align-items-end">
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input bg-dark border-secondary" type="checkbox" name="is_active" id="edit_service_is_active">
                                            <label class="form-check-label" for="edit_service_is_active">Aktív</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer border-secondary">
                                <button type="submit" class="btn btn-warning text-dark"><i class="fa-solid fa-save me-1"></i> Mentés</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
