                        <div class="card-body">
                            <% if (schemaEntries && schemaEntries.length) { %>
                                <% schemaEntries.forEach((entry) => { %>
                                <div class="p-3 mb-3 border rounded-3" style="background: rgba(255,255,255,0.02); border-color: rgba(212,176,107,0.18) !important;">
                                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                                        <div>
                                            <div class="fw-bold text-white"><%= entry.name || 'Schema elem' %></div>
                                            <small class="text-muted"><%= entry.type || 'Thing' %></small>
                                        </div>
                                        <span class="badge <%= entry.is_active == 1 ? 'bg-success' : 'bg-secondary' %> rounded-pill"><%= entry.is_active == 1 ? 'Aktív' : 'Inaktív' %></span>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    </div>
                                    <pre class="small mt-2 mb-3 p-3 rounded-3 text-white-50" style="background: rgba(8,11,15,0.78); border: 1px solid rgba(212,176,107,0.15); white-space: pre-wrap; overflow-x: auto; margin-bottom: 0; font-family: 'Courier New', monospace;"><%= entry.data_json %></pre>
                                    <div class="d-flex justify-content-end gap-2 mt-3 flex-wrap">
                                        <button type="button" class="btn btn-sm btn-outline-light" data-bs-toggle="modal" data-bs-target="#schemaEditModal<%= entry.id %>"><i class="fa-solid fa-pen me-1"></i> Szerkesztés</button>
                                        <form action="/admin/schema-delete/<%= entry.id %>" method="POST" data-confirm="Biztosan törli ezt a schema elemet?" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash me-1"></i> Törlés</button>
                                        </form>
                                    </div>
                                </div>
                                <% }) %>
                            <% } else { %>
                                <p class="mb-0 text-white-50">Még nincs Schema.org elem létrehozva.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Schema Edit Modals (külön, grid-en KÍVÜL — elkerüljük a villódzást, a Bootstrap a modal-t a body-hoz mozgatja megnyitáskor) -->
            <% if (schemaEntries && schemaEntries.length > 0) { %>
                <% schemaEntries.forEach((entry) => { %>
                <div class="modal fade" id="schemaEditModal<%= entry.id %>" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content bg-dark text-white">
                            <div class="modal-header border-secondary">
                                <h5 class="modal-title text-white">Schema szerkesztése</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <form action="/admin/schema-update/<%= entry.id %>" method="POST">
                                <div class="modal-body row g-3">
                                    <div class="col-12">
                                        <label class="form-label small">Név</label>
                                        <input type="text" name="name" class="form-control" value="<%= entry.name %>" required>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small">Típus</label>
                                        <input type="text" name="type" class="form-control" value="<%= entry.type || 'Thing' %>">
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small d-flex justify-content-between align-items-center"><span>JSON-LD adatok</span><span class="json-status" id="schema-status-<%= entry.id %>"></span></label>
                                        <div class="html-toolbar" data-for="schema-json-<%= entry.id %>">
                                            <button type="button" class="btn btn-sm btn-outline-light" data-action="json-format" title="JSON formázás"><i class="fa-solid fa-code me-1"></i> Formázás</button>
                                            <button type="button" class="btn btn-sm btn-outline-light" data-action="json-validate" title="JSON ellenőrzés"><i class="fa-solid fa-check me-1"></i> Ellenőrzés</button>
                                        </div>
                                        <textarea name="data_json" id="schema-json-<%= entry.id %>" class="form-control html-source" rows="14" required><%= entry.data_json %></textarea>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" name="is_active" <%= entry.is_active == 1 ? 'checked' : '' %>>
                                            <label class="form-check-label text-muted small">Publikus / aktív</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer border-secondary">
                                    <button type="submit" class="btn btn-wood w-100">Mentés</button>
                                </div>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            </form>
                        </div>
                    </div>
                </div>
                <% }) %>
            <% } %>
            <% } %>

            <!-- OLDALAK TAB -->
            <% if(tab == 'pages') { %>
            <div class="row g-4">
