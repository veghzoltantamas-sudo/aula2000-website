                                        <form action="/admin/page-delete/<%= page.id %>" method="POST" class="d-inline" data-confirm="Biztosan törli ezt az oldalt?">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Törlés</button>
                                        </form>
                                    </div>
                                </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
