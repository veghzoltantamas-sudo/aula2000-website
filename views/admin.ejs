                                    <button type="button" id="resetPageBuilder" class="btn btn-outline-light">Új oldal</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
