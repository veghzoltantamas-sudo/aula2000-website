                                    <div class="form-text">WhatsApp és Telefon gombok megjelenítése mobilon.</div>
                                </div>

<div class="card mb-4" id="faqCard"><div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2"><h5 class="fw-bold mb-0"><i class="fa-solid fa-question-circle me-2 text-warning"></i> Gyakori Kérdések</h5><div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" name="enable_faq" id="enableFaq" <%= settings.enable_faq == '1' ? 'checked' : '' %>><label class="form-check-label" for="enableFaq">Bekapcsolás</label></div></div><div class="card-body"><div id="faqList"></div><button type="button" class="btn btn-outline-warning btn-sm mt-3" id="addFaqBtn"><i class="fa-solid fa-plus me-1"></i> Új kérdés</button><textarea name="faq_items" id="faqItems" class="d-none"><%= settings.faq_items || '[]' %></textarea></div></div>

                                <button type="submit" class="btn btn-wood"><i class="fa-solid fa-save me-1"></i> Mentés</button>
                            </form>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header"><h5 class="fw-bold mb-0"><i class="fa-solid fa-database me-2 text-warning"></i> Adatbázis mentés</h5></div>
                        <div class="card-body">
                            <div class="d-flex gap-2 flex-wrap">
                                <a href="/admin/api/db-backup" class="btn btn-wood" download><i class="fa-solid fa-download me-1"></i> Backup letöltése (SQLite)</a>
                                <button id="manualBackupBtn" class="btn btn-outline-secondary" type="button"><i class="fa-solid fa-rotate me-1"></i> Manuális backup most</button>
                                <span id="backupStatus" class="align-self-center text-muted small ms-2"></span>
                            </div>
                            <hr class="my-3">
                            <h6 class="fw-bold small">Legutóbbi automatikus mentések</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-light"><tr><th>Fájl</th><th>Méret</th><th>Dátum</th><th></th></tr></thead>
                                    <tbody>
                                        <% if (typeof backups !== 'undefined' && backups.length) { backups.forEach(backup => { %>
                                        <tr><td><code><%= backup.name %></code></td><td><%= (backup.size / 1024 / 1024).toFixed(2) %> MB</td><td><%= new Date(backup.createdAt).toLocaleString('hu-HU') %></td><td><span class="badge <%= backup.valid ? 'bg-success' : 'bg-danger' %>"><%= backup.valid ? 'Érvényes SQLite' : 'Hibás fájl' %></span> <% if (backup.valid) { %><a href="/admin/api/db-backup-file/<%= backup.name %>" class="btn btn-sm btn-outline-light ms-1"><i class="fa-solid fa-download"></i></a><% } %></td></tr>
                                        <% }); } else { %>
                                        <tr><td colspan="4" class="text-center text-muted small">Nincsenek elmentett automatikus backupok.</td></tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card mb-4">
                        <div class="card-header"><h5 class="fw-bold mb-0"><i class="fa-solid fa-clock-rotate-left me-2 text-warning"></i> Automatikus backup</h5></div>
                        <div class="card-body">
                            <p class="text-muted small">A rendszer naponta egyszer (hajnal 3:00-kor) automatikusan készít biztonsági másolatot az adatbázisról a <code>data/backups/</code> mappába.</p>
                            <p class="text-muted small">A manuális backup letöltése a bal oldali gombbal lehetséges, vagy parancssorból: <code>sqlite3 data/database.sqlite .backup 'data/backups/manual-$(date +%F).sqlite'</code></p>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

        </div>
    </div>
</div>

<%- include('partials/admin-scripts') %>
