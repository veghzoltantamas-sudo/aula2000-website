                                    </div>
                                    <% } else { %><span class="small text-muted">Nincs külön galériakép.</span><% } %>
                                    <form action="/admin/workflows/<%= item.id %>/gallery-add" method="POST" enctype="multipart/form-data" class="workflow-gallery-add mt-2">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="file" name="workflow_image" accept="image/*" required>
