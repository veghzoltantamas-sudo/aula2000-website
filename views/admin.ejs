                                        </select>
                                    </form>
                                    <% } %>
                                </td>
                                <td>
                                    <form action="/admin/del-user/<%= u.id %>" method="POST" data-confirm="Biztosan törli ezt a felhasználót?">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash me-1"></i> Törlés</button>
