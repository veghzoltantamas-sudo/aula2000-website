                <div class="card-header"><i class="fa-solid fa-user-plus me-2"></i> Új felhasználó létrehozása</div>
                <div class="card-body">
                    <form action="/admin/add-user" method="POST" class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label small">Felhasználónév</label>
                            <input type="text" name="new_username" class="form-control" placeholder="admin2" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Jelszó</label>
                            <input type="password" name="new_password" class="form-control" placeholder="Legalább 8 karakter" required>
