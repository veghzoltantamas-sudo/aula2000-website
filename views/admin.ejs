                                <input type="url" name="youtube_url" class="form-control" value="<%= settings.youtube_url || 'https://www.youtube.com/watch?v=eDWUCJwwzcc&t=5s' %>">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small">Hero kép URL</label>
                                <input type="url" name="hero_image_url" class="form-control" value="<%= settings.hero_image_url || '' %>">
