                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <td><form action="/admin/update-lead-status/<%= lead.leadType %>/<%= lead.id %>" method="POST" class="d-flex gap-2 flex-wrap"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status" class="form-select form-select-sm" aria-label="Lead státusz"><% Object.entries({new:'Új',contacted:'Kapcsolatfelvétel',qualified:'Minősített',proposal:'Ajánlat elküldve',won:'Megnyert',lost:'Lezárt / elveszett'}).forEach(([key,label]) => { %><option value="<%= key %>" <%= currentStatus === key ? 'selected' : '' %>><%= label %></option><% }) %></select><button class="btn btn-sm btn-outline-light" type="submit">Mentés</button><textarea name="internal_notes" class="form-control form-control-sm w-100" rows="2" maxlength="5000" placeholder="Belső megjegyzés"><%= lead.internal_notes || '' %></textarea></form>
