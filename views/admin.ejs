                                    </form>
                                </div>
                                <div class="d-flex justify-content-between align-items-center border-top border-secondary pt-3 mt-2 gap-2">
                                    <a href="/munkafolyamatok/<%= item.slug %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-light"><i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Előnézet</a>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-warning" data-workflow-edit data-id="<%= item.id %>" data-title="<%= item.title.replace(/"/g, '&quot;') %>" data-slug="<%= (item.slug || '').replace(/"/g, '&quot;') %>" data-short_desc="<%= (item.short_desc || '').replace(/"/g, '&quot;') %>" data-description="<%= (item.description || '').replace(/"/g, '&quot;').replace(/\n/g, '&#10;') %>" data-gallery="<%= (item.gallery_images || '[]').replace(/"/g, '&quot;') %>" data-icon="<%= (item.icon || '').replace(/"/g, '&quot;') %>" data-sort_order="<%= item.sort_order %>" data-is_active="<%= item.is_active %>"><i class="fa-solid fa-pen me-1"></i> Szerkesztés</button>
