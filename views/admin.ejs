<!DOCTYPE html>
<html lang="hu">
<head>
    <%- include('partials/admin-head') %>
</head>
<body>

<div class="sidebar-overlay" id="sidebarOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1040;"></div>
<button class="sidebar-open-btn" id="sidebarToggle" style="display:none;align-items:center;justify-content:center;width:40px;height:40px;border:1px solid rgba(255,255,255,0.15);border-radius:8px;background:rgba(255,255,255,0.05);color:#fff;cursor:pointer;position:fixed;top:12px;left:12px;z-index:1050;" aria-label="Navigáció"><i class="fa-solid fa-bars"></i></button>
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-2 sidebar position-fixed">
            <h5 class="text-center mb-4 text-white fw-bold"><i class="fa-solid fa-drafting-compass me-2 text-warning"></i> AULA 2000</h5>
            <div class="px-3 pb-2 admin-search-wrap">
                <div class="admin-search-box position-relative">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input type="text" id="adminGlobalSearch" class="form-control form-control-sm bg-dark text-white border-secondary ps-4" placeholder="Keresés..." autocomplete="off">
                    <div id="adminSearchResults" class="admin-search-results d-none"></div>
                </div>
            </div>
            <div class="px-3 pb-2 mb-2">
                <div class="d-flex align-items-center gap-2 p-2 rounded" style="background: rgba(212,176,107,0.08); border: 1px solid rgba(212,176,107,0.15);">
                    <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold-deep));display:flex;align-items:center;justify-content:center;color:#000;font-weight:700;font-size:0.75rem;">
                        <%= currentUsername ? currentUsername.charAt(0).toUpperCase() : 'A' %>
                    </div>
                    <div>
                        <div class="text-white fw-bold small" style="line-height:1.2;"><%= currentUsername %></div>
                        <div class="small" style="color: var(--gold); font-size: 0.8rem; line-height:1.2;">
                            <% if (userRole === 'admin') { %><i class="fa-solid fa-crown me-1"></i>Admin<% } %>
                            <% if (userRole === 'editor') { %><i class="fa-solid fa-pen me-1"></i>Szerkesztő<% } %>
                            <% if (userRole === 'viewer') { %><i class="fa-solid fa-eye me-1"></i>Megtekintő<% } %>
                        </div>
                    </div>
                </div>
            </div>
            <a href="?tab=content" class="<%= tab == 'content' ? 'active' : '' %>"><i class="fa-solid fa-pen-nib me-2"></i> Oldal Beállítások</a>
            <a href="?tab=marketing" class="<%= tab == 'marketing' ? 'active' : '' %>"><i class="fa-solid fa-bullhorn me-2"></i> Marketing</a>
            <a href="?tab=pwa" class="<%= tab == 'pwa' ? 'active' : '' %>"><i class="fa-solid fa-mobile-screen-button me-2"></i> PWA</a>
            <a href="?tab=smtp" class="<%= tab == 'smtp' ? 'active' : '' %>"><i class="fa-solid fa-at me-2"></i> SMTP</a>
            <a href="?tab=email" class="<%= tab == 'email' ? 'active' : '' %>"><i class="fa-solid fa-envelope-open-text me-2"></i> E-mail sablonok</a>
            <a href="?tab=services" class="<%= tab == 'services' ? 'active' : '' %>"><i class="fa-solid fa-list-check me-2"></i> Szolgáltatások</a>
            <a href="?tab=workflows" class="<%= tab == 'workflows' ? 'active' : '' %>"><i class="fa-solid fa-route me-2"></i> Munkafolyamatok</a>
            <a href="?tab=projects" class="<%= tab == 'projects' ? 'active' : '' %>"><i class="fa-solid fa-pencil-ruler me-2"></i> Referencia Munkák</a>
            <a href="?tab=before-after" class="<%= tab == 'before-after' ? 'active' : '' %>"><i class="fa-solid fa-arrow-right-arrow-left me-2"></i> Előtte / Utána</a>
            <a href="?tab=media" class="<%= tab == 'media' ? 'active' : '' %>"><i class="fa-solid fa-photo-film me-2"></i> Média könyvtár</a>
            <a href="?tab=testimonials" class="<%= tab == 'testimonials' ? 'active' : '' %>"><i class="fa-solid fa-quote-right me-2"></i> Vélemények</a>
            <a href="?tab=partners" class="<%= tab == 'partners' ? 'active' : '' %>"><i class="fa-solid fa-handshake me-2"></i> Partnerek</a>
            <a href="?tab=pages" class="<%= tab == 'pages' ? 'active' : '' %>"><i class="fa-solid fa-file-lines me-2"></i> Oldalak</a>
            <a href="?tab=schema" class="<%= tab == 'schema' ? 'active' : '' %>"><i class="fa-solid fa-code me-2"></i> Schema.org</a>
            <a href="?tab=blog" class="<%= tab == 'blog' ? 'active' : '' %>"><i class="fa-solid fa-pen-nib me-2"></i> Blog</a>
            <a href="?tab=analytics" class="<%= tab == 'analytics' ? 'active' : '' %>"><i class="fa-solid fa-chart-line me-2"></i> Analytics</a>
            <a href="?tab=newsletter" class="<%= tab == 'newsletter' ? 'active' : '' %>"><i class="fa-solid fa-paper-plane me-2"></i> Hírlevél <% if (newsletterCount > 0) { %><span class="nav-badge ms-2"><%= newsletterCount %></span><% } %></a>
            <a href="?tab=crm" class="<%= tab == 'crm' ? 'active' : '' %>"><i class="fa-solid fa-chart-kanban me-2"></i> CRM pipeline <% if (crmLeads && crmLeads.filter(l => l.status === 'new' || l.pipelineStatus === 'new').length > 0) { %><span class="nav-badge ms-2"><%= crmLeads.filter(l => l.status === 'new' || l.pipelineStatus === 'new').length %></span><% } %></a>
            <a href="?tab=compliance" class="<%= tab == 'compliance' ? 'active' : '' %>"><i class="fa-solid fa-shield-halved me-2"></i> GDPR / Adatvédelem</a>
            <a href="?tab=ugyfelkapu" class="<%= tab == 'ugyfelkapu' ? 'active' : '' %>"><i class="fa-solid fa-user-lock me-2"></i> Ügyfélkapu</a>
            <a href="?tab=users" class="<%= tab == 'users' ? 'active' : '' %>"><i class="fa-solid fa-user-gear me-2"></i> Felhasználók</a>
            <a href="?tab=settings" class="<%= tab == 'settings' ? 'active' : '' %>"><i class="fa-solid fa-gear me-2"></i> Beállítások</a>
            <a href="?tab=logs" class="<%= tab == 'logs' ? 'active' : '' %>"><i class="fa-solid fa-scroll me-2"></i> Napló <% if (activityLogs && activityLogs.filter(l => l.level === 'error').length > 0) { %><span class="nav-badge pulse ms-2"><%= activityLogs.filter(l => l.level === 'error').length %></span><% } %></a>
            <a href="?tab=messages" class="<%= tab == 'messages' ? 'active' : '' %>"><i class="fa-solid fa-envelope me-2"></i> Üzenetek <% if (unreadMessages > 0) { %><span class="nav-badge pulse ms-2"><%= unreadMessages %></span><% } %></a>
            <a href="/" target="_blank" class="mt-4"><i class="fa-solid fa-eye me-2"></i> Weboldal</a>
            <form action="/logout" method="POST" class="mt-5">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-link text-danger p-0 text-decoration-none"><i class="fa-solid fa-power-off me-2"></i> Kijelentkezés</button>
            </form>
        </div>

        <!-- Main Content -->
        <div class="col-md-10 offset-md-2 p-5 content-shell">
            <% if(msg) { %>
                <div class="alert alert-success bg-white border-0 shadow-sm border-start border-success border-4 fw-bold"><i class="fa-solid fa-check me-2"></i> Változtatások mentve!</div>
            <% } %>

            <div class="crm-summary row g-3">
                <div class="col-md-4">
                    <div class="summary-card">
                        <span class="summary-label">Aktív projektek</span>
                        <strong><%= projects.length %></strong>
                        <small>Referencia és gyártási portfólió</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="summary-card">
                        <span class="summary-label">Olvasatlan üzenetek</span>
                        <strong><%= unreadMessages %></strong>
                        <small><%= messages.length %> összes ajánlatkérés · figyelésre vár</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="summary-card">
                        <span class="summary-label">Felhasználók</span>
                        <strong><%= users.length %></strong>
                        <small>Admin és hozzáférési szintek</small>
                    </div>
                </div>
            </div>

            <% if(tab == 'content' || tab == 'dashboard') { %>
            <!-- PageSpeed Insights Widget -->
            <div class="row g-3 mb-4">
                <div class="col-lg-6">
                    <div class="summary-card h-100">
                        <h6 class="fw-bold mb-3"><i class="fa-solid fa-gauge-high me-2 text-warning"></i> PageSpeed Insights</h6>
                        <div id="pageSpeedWidget">
                            <div class="text-muted small mb-2">Betöltés...</div>
                        </div>
                        <button class="btn btn-sm btn-outline-secondary mt-2" id="psBtn"><i class="fa-solid fa-rotate me-1"></i> Újramérés</button>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="summary-card h-100">
                        <h6 class="fw-bold mb-3"><i class="fa-solid fa-chart-bar me-2 text-warning"></i> Leglátogatottabb oldalak (30 nap)</h6>
                        <div style="height: 240px;"><canvas id="analyticsChart"></canvas></div>
                    </div>
                </div>
            </div>
            <% } %>

            <% if(tab == 'content') { %>
            <div class="row g-3 mb-4">
                <div class="col-lg-8">
                    <div class="latest-message-card">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <h5 class="fw-bold text-white mb-0"><i class="fa-solid fa-bell me-2 text-warning"></i> Beérkezett üzenet előnézet</h5>
                            <% if (latestMessage) { %>
                                <span class="message-status <%= latestMessage.status %>"><%= latestMessage.statusLabel %></span>
                            <% } %>

                        </div>
                        <% if (latestMessage) { %>
                            <div class="text-warning small fw-bold mb-2"><%= latestMessage.name %> · <%= latestMessage.date %></div>
                            <p class="mb-3 text-white-50"><%= latestMessage.message %></p>
                            <div class="d-flex flex-wrap gap-3 text-muted small">
                                <span><i class="fa-solid fa-envelope me-1"></i> <%= latestMessage.email %></span>
                                <% if (latestMessage.phone) { %><span><i class="fa-solid fa-phone me-1"></i> <%= latestMessage.phone %></span><% } %>
                            </div>
                        <% } else { %>
                            <p class="mb-0 text-white-50">Még nincs bejövő üzenet.</p>
                        <% } %>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="summary-card h-100">
                        <span class="summary-label">Prioritás</span>
                        <strong><%= importantMessages %></strong>
                        <small>Fontos ügyek a várólistán</small>
                    </div>
                </div>
            </div>
            <% } %>

            <% if(tab == 'marketing' || tab == 'settings') { %>
            <div class="d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
                <div>
                    <h3 class="fw-bold m-0 text-white">Marketing modul</h3>
                    <p class="text-muted mb-0 mt-2">Vállalkozás, SEO, közösségi csatornák és premium kampányok kezelése.</p>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><i class="fa-solid fa-building me-2 text-warning"></i> Vállalkozás és marketing adatok</div>
                <div class="card-body">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <form action="/admin/update-settings" method="POST">
                        <input type="hidden" name="module" value="marketing">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small">Cég neve</label>
                                <input type="text" name="company_name" class="form-control" value="<%= settings.company_name || 'Aula 2000' %>">
                                <label class="form-label text-muted small mt-3">Rövid név</label>
                                <input type="text" name="company_short_name" class="form-control" value="<%= settings.company_short_name || 'Aula 2000' %>">
                                <label class="form-label text-muted small mt-3">Vállalkozás bemutatása</label>
                                <textarea name="company_description" class="form-control" rows="3"><%= settings.company_description || 'Prémium építész iroda, generál tervezés, beruházás bonyolítás és műszaki ellenőrzés.' %></textarea>
                                <label class="form-label text-muted small mt-3">Cím</label>
                                <input type="text" name="business_address" class="form-control" value="<%= settings.business_address || '8000 Székesfehérvár, Fa utca 12.' %>">
                                <label class="form-label text-muted small mt-3">Nyitvatartás</label>
                                <input type="text" name="business_opening_hours" class="form-control" value="<%= settings.business_opening_hours || 'H-P 08:00-18:00' %>">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small">WhatsApp szám</label>
                                <input type="text" name="whatsapp_number" class="form-control" value="<%= settings.whatsapp_number || '+36305555555' %>">
                                <label class="form-label text-muted small mt-3">WhatsApp üzenet</label>
                                <textarea name="whatsapp_message" class="form-control" rows="2"><%= settings.whatsapp_message || 'Üdvözlöm! Szeretnék árajánlatot kérni.' %></textarea>
                                <label class="form-label text-muted small mt-3">Facebook URL</label>
                                <input type="url" name="facebook_url" class="form-control" value="<%= settings.facebook_url || 'https://facebook.com/' %>">
                                <label class="form-label text-muted small mt-3">Instagram URL</label>
                                <input type="url" name="instagram_url" class="form-control" value="<%= settings.instagram_url || 'https://instagram.com/' %>">
                                <label class="form-label text-muted small mt-3">YouTube URL</label>
                                <input type="url" name="youtube_url" class="form-control" value="<%= settings.youtube_url || 'https://www.youtube.com/watch?v=eDWUCJwwzcc&t=5s' %>">
                            </div>
                        </div>
                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <label class="form-label text-muted small">SEO leírás</label>
                                <textarea name="seo_description" class="form-control" rows="3"><%= settings.seo_description || 'Aula 2000 Építész Iroda — Családi házak, társasházak, ipari és középületek generál tervezése, beruházás lebonyolítása.' %></textarea>
                                <label class="form-label text-muted small mt-3">SEO kulcsszavak</label>
                                <input type="text" name="seo_keywords" class="form-control" value="<%= settings.seo_keywords || 'építész, építészet, generál tervezés, beruházás bonyolítás, 3D látványterv, műszaki ellenőrzés, energetikai tanúsítás, Szeged építész' %>">
                                <label class="form-label text-muted small mt-3">Hero kép URL</label>
                                <input type="url" name="hero_image_url" class="form-control" value="<%= settings.hero_image_url || '' %>">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small">Évek száma</label>
                                <input type="text" name="stat_years" class="form-control" value="<%= settings.stat_years || '15' %>">
                                <label class="form-label text-muted small mt-3">Projekt száma</label>
                                <input type="text" name="stat_projects" class="form-control" value="<%= settings.stat_projects || '350' %>">
                                <label class="form-label text-muted small mt-3">Válaszidő (óra)</label>
                                <input type="text" name="stat_response_hours" class="form-control" value="<%= settings.stat_response_hours || '24' %>">
                                <label class="form-label text-muted small mt-3">Fő szín</label>
                                <input type="color" name="brand_primary_color" class="form-control form-control-color w-100" value="<%= settings.brand_primary_color || '#d5ab5d' %>">
                                <label class="form-label text-muted small mt-3">Másodlagos szín</label>
                                <input type="color" name="brand_secondary_color" class="form-control form-control-color w-100" value="<%= settings.brand_secondary_color || '#f5efe8' %>">
                            </div>
                        </div>
                        <button type="submit" class="btn btn-wood mt-4"><i class="fa-solid fa-floppy-disk me-2"></i> Marketing mentése</button>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    </form>

                    <form class="mt-4 pt-4 border-top border-secondary">
                        <h5 class="fw-bold text-white mb-1"><i class="fa-solid fa-images me-2 text-warning"></i> Beállítási képek</h5>
                        <p class="text-muted small mb-3">Itt tölthetsz fel, cserélhetsz vagy törölhetsz képeket. A feltöltés automatikusan webp-be optimalizálódik, a kicserélt/törölt régi fájl törlődik a szerverről.</p>
                    </form>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="text-muted small mb-1">Hero háttérkép</div>
                            <% if (settings.hero_image_url) { %>
                            <div class="mb-2"><img src="<%= settings.hero_image_url %>" style="width:100%;max-height:120px;object-fit:cover;border-radius:8px;border:1px solid #333" alt="Hero kép"></div>
                            <form action="/admin/delete-site-image/hero" method="POST" data-confirm="Törlöd a hero képet? A helyére a sötét gradens kerül.">
                                <button type="submit" class="btn btn-sm btn-outline-danger mb-2"><i class="fa-solid fa-trash me-1"></i> Kép törlése</button>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            </form>
                            <% } else { %>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <p class="text-muted small">Nincs egyéni hero kép (sötét gradens fut).</p>
                            <% } %>
                            <form action="/admin/site-image/hero" method="POST" enctype="multipart/form-data">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="file" name="image" accept="image/png,image/jpeg,image/webp" class="form-control form-control-sm mb-2" required>
                                <button type="submit" class="btn btn-sm btn-wood"><i class="fa-solid fa-upload me-1"></i> Feltöltés / csere</button>
                            </form>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small mb-1">"Építész Iroda" galéria kép</div>
                            <% if (settings.about_image_url) { %>
                            <div class="mb-2"><img src="<%= settings.about_image_url %>" style="width:100%;max-height:120px;object-fit:cover;border-radius:8px;border:1px solid #333" alt="Építész Iroda kép"></div>
                            <form action="/admin/delete-site-image/about" method="POST" data-confirm="Törlöd az építész iroda képet?">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-sm btn-outline-danger mb-2"><i class="fa-solid fa-trash me-1"></i> Kép törlése</button>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            </form>
                            <% } else { %>
                            <p class="text-muted small">Nincs egyéni kép beállítva.</p>
                            <% } %>
                            <form action="/admin/site-image/about" method="POST" enctype="multipart/form-data">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="file" name="image" accept="image/png,image/jpeg,image/webp" class="form-control form-control-sm mb-2" required>
                                <button type="submit" class="btn btn-sm btn-wood"><i class="fa-solid fa-upload me-1"></i> Feltöltés / csere</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

            <% if(tab == 'pwa') { %>
            <div class="d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
                <div>
                    <h3 class="fw-bold m-0 text-white">PWA / install modul</h3>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <p class="text-muted mb-0 mt-2">App név, install prompt, splash, és platform konfiguráció.</p>
                </div>
            </div>
            <div class="card">
                <div class="card-header"><i class="fa-solid fa-mobile-screen-button me-2 text-warning"></i> PWA / install és splash beállítások</div>
                <div class="card-body">
                    <form action="/admin/update-settings" method="POST">
                        <input type="hidden" name="module" value="pwa">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small">App név</label>
                                <input type="text" name="pwa_name" class="form-control" value="<%= settings.pwa_name || 'Aula 2000' %>">
                                <label class="form-label text-muted small mt-3">Rövid név</label>
                                <input type="text" name="pwa_short_name" class="form-control" value="<%= settings.pwa_short_name || 'Aula 2000' %>">
                                <label class="form-label text-muted small mt-3">Display mód</label>
                                <select name="pwa_display" class="form-select">
                                    <option value="standalone" <%= (settings.pwa_display || 'standalone') === 'standalone' ? 'selected' : '' %>>standalone</option>
                                    <option value="fullscreen" <%= settings.pwa_display === 'fullscreen' ? 'selected' : '' %>>fullscreen</option>
                                    <option value="minimal-ui" <%= settings.pwa_display === 'minimal-ui' ? 'selected' : '' %>>minimal-ui</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small">Theme color</label>
                                <input type="color" name="pwa_theme_color" class="form-control form-control-color w-100" value="<%= settings.pwa_theme_color || '#d5ab5d' %>">
                                <label class="form-label text-muted small mt-3">Background color</label>
                                <input type="color" name="pwa_background_color" class="form-control form-control-color w-100" value="<%= settings.pwa_background_color || '#0a0d11' %>">
                                <label class="form-label text-muted small mt-3">VAPID publikus kulcs (push értesítések)</label>
                                <input type="text" name="vapid_public_key" class="form-control" value="<%= settings.vapid_public_key || '' %>" placeholder="BrowserPush VAPID publikus kulcs">
                                <label class="form-label text-muted small mt-3">VAPID privát kulcs</label>
                                <input type="password" name="vapid_private_key" class="form-control" value="<%= settings.vapid_private_key || '' %>" placeholder="BrowserPush VAPID privát kulcs">
                                <div class="form-text text-white-50">A push értesítésekhez szükséges. Üresen hagyva kikapcsolva maradnak.</div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-wood mt-4"><i class="fa-solid fa-save me-2"></i> PWA mentése</button>
                    </form>
                </div>
            </div>

            <hr class="border-secondary mt-4">
            <div class="card">
                <div class="card-header"><i class="fa-solid fa-bell me-2 text-warning"></i> Push értesítés küldése (Broadcast)</div>
                <div class="card-body">
                    <form id="pushBroadcastForm" action="/admin/api/push-broadcast" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
