                            <% partners.forEach(p => { %>
                            <div class="col-md-4 col-lg-3 partner-item" data-id="<%= p.id %>">
                                <div class="card h-100 bg-dark border-secondary">
                                    <div class="card-body text-center p-3">
                                        <div class="drag-handle mb-2" title="Húzd az átrendezéshez"><i class="fa-solid fa-grip-lines text-muted"></i></div>
                                        <% if (p.logo_url) { %>
                                        <img src="<%= p.logo_url %>" alt="<%= p.name %>" style="max-height: 80px; max-width: 100%; object-fit: contain;" class="mb-2">
                                        <% } else { %>
                                        <div class="mb-2 text-muted small">Nincs logo</div>
                                        <% } %>
                                        <h6 class="fw-bold mb-1"><%= p.name %></h6>
                                        <% if (p.website) { %>
                                        <a href="<%= p.website %>" target="_blank" class="text-info small text-decoration-none"><i class="fa-solid fa-globe me-1"></i> Weboldal</a>
                                        <% } %>
                                    </div>
                                    <div class="card-footer bg-transparent border-top border-secondary d-flex gap-2">
                                        <button class="btn btn-sm btn-outline-primary flex-fill" data-bs-toggle="modal" data-bs-target="#editPartnerModal<%= p.id %>"><i class="fa-solid fa-pen me-1"></i> Szerkesztés</button>
                                        <form action="/admin/partner-delete/<%= p.id %>" method="POST" data-confirm="Biztosan törlöd ezt a partnert?" style="display:inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-sm btn-outline-danger flex-fill"><i class="fa-solid fa-trash me-1"></i> Törlés</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                        <% } else { %>
                            <div class="col-12 text-center py-5 text-muted">Még nincsenek partnerek. Kattints az <i class="fa-solid fa-plus me-1"></i> Új partner gombra.</div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Partner Modals (külön, grid-en KÍVÜL — elkerüljük a villódzást, a Bootstrap a modal-t a body-hoz mozgatja megnyitáskor) -->
            <% if (partners && partners.length > 0) { %>
                <% partners.forEach(p => { %>
                <div class="modal fade" id="editPartnerModal<%= p.id %>" tabindex="-1" data-bs-theme="dark">
                    <div class="modal-dialog modal-sm modal-dialog-centered">
                        <div class="modal-content bg-dark text-white">
                            <div class="modal-header border-secondary">
                                <h6 class="modal-title">Partner szerkesztése</h6>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <form action="/admin/partner-update/<%= p.id %>" method="POST">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="modal-body">
                                    <div class="mb-3"><label class="form-label">Név</label><input type="text" name="name" class="form-control bg-secondary text-white border-0" value="<%= p.name %>" required></div>
