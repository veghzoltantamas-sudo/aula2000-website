                                <input type="text" name="seo_keywords" class="form-control" value="<%= settings.seo_keywords || 'építész, építészet, generál tervezés, beruházás bonyolítás, 3D látványterv, műszaki ellenőrzés, energetikai tanúsítás, Szeged építész' %>">
                                <label class="form-label text-muted small mt-3">Évek száma</label>
                                <input type="text" name="stat_years" class="form-control" value="<%= settings.stat_years || '15' %>">
