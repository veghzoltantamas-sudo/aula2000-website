                            <div class="col-md-8"><label class="form-label">Munkafolyamat képei</label><input type="file" name="workflow_images" class="form-control bg-dark text-white border-secondary" accept="image/*" multiple><div class="form-text text-white-50">Az első kép lesz a borító, a többi a részletező galériába kerül.</div></div>
                            <div class="col-md-4 d-flex align-items-end"><div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="is_active" checked><label class="form-check-label">Publikus</label></div></div>
                        </div></div>
                        <div class="modal-footer border-secondary"><button type="submit" class="btn btn-warning text-dark"><i class="fa-solid fa-save me-1"></i> Létrehozás</button></div>
                    </form>
                </div></div>
            </div>

            <div class="modal fade" id="editWorkflowModal" tabindex="-1">
                <div class="modal-dialog modal-lg"><div class="modal-content bg-dark text-white border-secondary">
                    <form id="editWorkflowForm" action="" method="POST" enctype="multipart/form-data">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="modal-header border-secondary"><h5 class="modal-title">Munkafolyamat szerkesztése</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
                        <div class="modal-body"><div class="row g-3">
                            <div class="col-md-6"><label class="form-label">Cím *</label><input type="text" name="title" id="edit_workflow_title" class="form-control bg-dark text-white border-secondary" required></div>
                            <div class="col-md-6"><label class="form-label">Slug</label><input type="text" name="slug" id="edit_workflow_slug" class="form-control bg-dark text-white border-secondary"></div>
                            <div class="col-md-8"><label class="form-label">Ikon</label><input type="text" name="icon" id="edit_workflow_icon" class="form-control bg-dark text-white border-secondary"></div>
                            <div class="col-md-4"><label class="form-label">Sorrend</label><input type="number" name="sort_order" id="edit_workflow_sort_order" class="form-control bg-dark text-white border-secondary"></div>
                            <div class="col-12"><label class="form-label">Rövid leírás</label><textarea name="short_desc" id="edit_workflow_short_desc" class="form-control bg-dark text-white border-secondary" rows="2" maxlength="255"></textarea></div>
                            <div class="col-12"><label class="form-label">Részletes leírás</label><textarea name="description" id="edit_workflow_description" class="form-control bg-dark text-white border-secondary" rows="8"></textarea></div>
                            <div class="col-md-8"><label class="form-label">Új képsorozat (üresen marad a régi)</label><input type="file" name="workflow_images" id="edit_workflow_images" class="form-control bg-dark text-white border-secondary" accept="image/*" multiple><div id="editWorkflowGalleryPreview" class="d-flex flex-wrap gap-2 mt-2"></div><div class="form-text text-white-50">Feltöltéskor az első kép lesz a borító, a többi lecseréli a galériát.</div></div>
                            <div class="col-md-4 d-flex align-items-end"><div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="is_active" id="edit_workflow_is_active"><label class="form-check-label">Publikus</label></div></div>
                        </div></div>
                        <div class="modal-footer border-secondary"><button type="submit" class="btn btn-warning text-dark"><i class="fa-solid fa-save me-1"></i> Mentés</button></div>
                    </form>
                </div></div>
            </div>
            <% } %>

            <!-- REFERENCIÁK TAB -->
            <% if(tab == 'projects') { %>
            <div class="d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
                <h3 class="fw-bold m-0 text-white">Referencia Munkák Kezelése</h3>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-danger btn-sm" id="bulk-project-delete-btn" style="display:none" onclick="if(confirm('Biztosan törli a kijelölt projekteket?')) document.getElementById('bulk-project-form').submit()"><i class="fa-solid fa-trash me-2"></i> Kijelöltek törlése</button>
                    <button class="btn btn-wood px-4" data-bs-toggle="modal" data-bs-target="#addProjectModal"><i class="fa-solid fa-plus me-2"></i> Új Munka Hozzáadása</button>
                </div>
            </div>

            <form id="bulk-project-form" action="/admin/projects/bulk-delete" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            </form>

            <div class="filter-toolbar" data-filter-group="projects">
                <div class="d-flex align-items-center gap-3">
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" id="project-select-all">
                        <label class="form-check-label text-white-50 small" for="project-select-all">Összes kijelölése</label>
                    </div>
                    <button type="button" class="filter-pill active" data-filter-target="all">Összes</button>
                    <button type="button" class="filter-pill" data-filter-target="featured">Kiemelt</button>
                </div>
            </div>

            <div class="row g-4 project-grid">
                <% projects.forEach(p => { %>
                <div class="col-md-4 project-item <%= p.is_featured == 1 ? 'featured' : '' %>" data-featured="<%= p.is_featured == 1 ? 'featured' : 'standard' %>">
                    <div class="card h-100 position-relative">
                        <div class="position-absolute top-0 start-0 m-2" style="z-index: 10;">
                            <input type="checkbox" name="ids" value="<%= p.id %>" form="bulk-project-form" class="project-checkbox" style="width:20px;height:20px;cursor:pointer">
                        </div>
                        <img src="<%= p.cover ? (p.cover.startsWith('http') ? p.cover : '/uploads/' + p.cover) : 'https://via.placeholder.com/400x300' %>" style="height:220px; object-fit:cover; border-radius: 10px 10px 0 0;">
                        <div class="card-body text-center">
                            <span class="text-warning fw-bold small text-uppercase"><%= p.category %></span>
                            <h5 class="fw-bold mt-2"><%= p.title %></h5>
                        </div>
                        <div class="card-footer bg-white text-center border-0 pb-3">
                            <div class="d-flex justify-content-center gap-2">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editProjectModal<%= p.id %>"><i class="fa-solid fa-pen me-1"></i> Szerkesztés</button>
                                <form action="/admin/del-project/<%= p.id %>" method="POST" data-confirm="Biztosan törli ezt a munkát a galériával együtt?">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash me-1"></i> Törlés</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>

            <!-- Project Edit Modals + Subimage Modals (külön, grid-en KÍVÜL — elkerüljük a villódzást) -->
            <% if (projects && projects.length > 0) { %>
                <% projects.forEach(p => { %>
                <!-- Modal for Editing Project -->
               
                  <div class="modal-dialog modal-lg">
                    <div class="modal-content bg-dark text-white">
                      <div class="modal-header border-secondary">
                        <h5 class="modal-title fw-bold">Projekt Szerkesztése</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                      </div>
                      <div class="modal-body p-4">
                        <form action="/admin/project-edit/<%= p.id %>" method="POST" enctype="multipart/form-data">
                            <div class="mb-3">
                                <label class="form-label fw-bold" style="color: #e0e0e0; font-weight: 500;">Cím szerkesztése</label>
                                <input type="text" name="title" class="form-control bg-secondary text-white border-0" value="<%= p.title %>" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold" style="color: #e0e0e0; font-weight: 500;">Kategória</label>
                                <input type="text" name="category" class="form-control bg-secondary text-white border-0" value="<%= p.category %>" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold" style="color: #e0e0e0; font-weight: 500;">Leírás</label>
                                <textarea name="description" rows="4" class="form-control bg-secondary text-white border-0"><%= p.description %></textarea>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-md-6"><label class="form-label small">Ügyfél / megrendelő</label><input name="client" class="form-control" value="<%= p.client || '' %>"></div>
                                <div class="col-md-6"><label class="form-label small">Helyszín</label><input name="location" class="form-control" value="<%= p.location || '' %>"></div>
                                <div class="col-md-4"><label class="form-label small">Év</label><input name="project_year" class="form-control" value="<%= p.project_year || '' %>"></div>
                                <div class="col-md-4"><label class="form-label small">Időtartam</label><input name="duration" class="form-control" value="<%= p.duration || '' %>"></div>
                                <div class="col-md-4"><label class="form-label small">Anyagok</label><input name="materials" class="form-control" value="<%= p.materials || '' %>"></div>
                                <div class="col-12"><label class="form-label small">Kihívás</label><textarea name="challenge" rows="2" class="form-control"><%= p.challenge || '' %></textarea></div>
                                <div class="col-12"><label class="form-label small">Megoldás</label><textarea name="solution" rows="2" class="form-control"><%= p.solution || '' %></textarea></div>
                                <div class="col-12"><label class="form-label small">Eredmény</label><textarea name="result" rows="2" class="form-control"><%= p.result || '' %></textarea></div>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="col-12"><label class="form-label small">Ügyfélidézet</label><textarea name="testimonial" rows="2" class="form-control"><%= p.testimonial || '' %></textarea></div>
                            </div>
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" name="is_featured" id="featured<%= p.id %>" <%= p.is_featured == 1 ? 'checked' : '' %>>
                                <label class="form-check-label" for="featured<%= p.id %>" style="color: #e0e0e0;">Kiemelt projekt</label>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold" style="color: #e0e0e0; font-weight: 500;">Új Borítókép (opcionális)</label>
                                <input type="file" name="cover" class="form-control bg-secondary text-white border-0" accept="image/*">
                            </div>
                            <button type="submit" class="btn btn-primary w-100 mb-4">Projekt Mentése</button>
                        </form>
                        
                        <hr class="border-secondary">
                        <h6 class="fw-bold mb-3" style="color: #e0e0e0; font-weight: 500;">Új alképek hozzáadása</h6>
                        <form action="/admin/add-subimages/<%= p.id %>" method="POST" enctype="multipart/form-data" class="mb-4">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="input-group">
                                <input type="file" name="new_images" class="form-control bg-secondary text-white border-0" accept="image/*" multiple required>
                                <button type="submit" class="btn btn-success" style="font-weight: 500;">Hozzáadás</button>
                            </div>
                        </form>

                        <hr class="border-secondary">
                        <h6 class="fw-bold mb-3" style="color: #e0e0e0;">Alképek kezelése <small class="text-muted">(húzd át a sorrendet)</small></h6>
                        <div class="row g-2 sortable-gallery" id="gallery-<%= p.id %>" data-project-id="<%= p.id %>">
                            <% allImages.filter(img => img.project_id === p.id).sort((a,b) => (a.sort_order||0) - (b.sort_order||0)).forEach(img => { %>
                                <% const subImage = img.filename && img.filename.startsWith('http') ? img.filename : '/uploads/' + img.filename; %>
                                <div class="col-4 position-relative sortable-item" data-id="<%= img.id %>">
                                    <img src="<%= subImage %>" class="img-fluid rounded" style="height: 100px; width: 100%; object-fit: cover;">
                                    <div class="mt-1">
                                        <input type="text" class="form-control form-control-sm bg-secondary text-white border-0 alt-text-input" data-id="<%= img.id %>" value="<%= img.alt_text || '' %>" placeholder="Alt szöveg (SEO)" style="font-size:0.7rem;">
                                    </div>
                                    <div class="position-absolute top-50 start-50 translate-middle d-flex gap-2 opacity-90">
                                        <button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#editSubImageModal<%= img.id %>"><i class="fa-solid fa-pen"></i></button>
                                        <form action="/admin/del-subimage/<%= img.id %>" method="POST" data-confirm="Törlöd ezt a képet?">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-sm btn-danger"><i class="fa-solid fa-trash"></i></button>
                                        </form>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                
                <!-- Subimage Edit Modals -->
                <% allImages.filter(img => img.project_id === p.id).forEach(img => { %>
                <div class="modal fade" id="editSubImageModal<%= img.id %>" tabindex="-1" data-bs-theme="dark">
                  <div class="modal-dialog modal-sm modal-dialog-centered">
                    <div class="modal-content bg-dark text-white">
                      <div class="modal-header border-secondary">
                        <h6 class="modal-title">Kép Cseréje</h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                      </div>
                      <form action="/admin/replace-subimage/<%= img.id %>" method="POST" enctype="multipart/form-data">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <div class="modal-body">
                              <label style="color: #e0e0e0; font-weight: 500;" class="mb-2">Válassz új képet:</label>
                              <input type="file" name="subimage" class="form-control bg-secondary text-white border-0 form-control-sm" accept="image/*" required>
                          </div>
                          <div class="modal-footer border-secondary p-2">
                              <button type="submit" class="btn btn-sm btn-primary w-100">Lecserél</button>
                          </div>
                      </form>
                    </div>
                  </div>
                </div>
                <% }) %>
                <% }) %>
            <% } %>

            <!-- Modal for Adding Project -->
            <div class="modal fade" id="addProjectModal" tabindex="-1">
              <div class="modal-dialog modal-lg">
                <form action="/admin/add-project" method="POST" enctype="multipart/form-data" class="modal-content bg-dark text-white border-0">
                  <div class="modal-header border-secondary">
                    <h5 class="modal-title fw-bold text-white">Új Referencia Feltöltése</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                  </div>
                  <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label fw-bold">Munka Megnevezése</label><input type="text" name="title" class="form-control" placeholder="pl. Modern tölgyfa konyha" required></div>
                        <div class="col-md-6"><label class="form-label fw-bold">Kategória</label><input type="text" name="category" class="form-control" placeholder="pl. Családi ház, Társasház, Ipari csarnok" required></div>
                        <div class="col-12"><label class="form-label fw-bold">Rövid Leírás</label><textarea name="description" class="form-control" rows="4"></textarea></div>
                        <div class="col-md-6"><label class="form-label fw-bold">Ügyfél / megrendelő</label><input name="client" class="form-control"></div>
                        <div class="col-md-6"><label class="form-label fw-bold">Helyszín</label><input name="location" class="form-control"></div>
                        <div class="col-md-4"><label class="form-label fw-bold">Év</label><input name="project_year" class="form-control"></div>
                        <div class="col-md-4"><label class="form-label fw-bold">Időtartam</label><input name="duration" class="form-control"></div>
                        <div class="col-md-4"><label class="form-label fw-bold">Anyagok</label><input name="materials" class="form-control"></div>
                        <div class="col-12"><label class="form-label fw-bold">Kihívás</label><textarea name="challenge" rows="2" class="form-control"></textarea></div>
                        <div class="col-12"><label class="form-label fw-bold">Megoldás</label><textarea name="solution" rows="2" class="form-control"></textarea></div>
                        <div class="col-12"><label class="form-label fw-bold">Eredmény</label><textarea name="result" rows="2" class="form-control"></textarea></div>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="col-12"><label class="form-label fw-bold">Ügyfélidézet</label><textarea name="testimonial" rows="2" class="form-control"></textarea></div>
                        
                        <div class="col-md-6 mt-4"><label class="form-label fw-bold text-success"><i class="fa-solid fa-image me-1"></i> Főkép (Borító)</label><input type="file" name="cover" class="form-control" accept="image/*" required></div>
                        <div class="col-md-6 mt-4"><label class="form-label fw-bold text-muted"><i class="fa-solid fa-images me-1"></i> Alképek (Max 15 kép a galériába)</label><input type="file" name="gallery" class="form-control" accept="image/*" multiple></div>
                    </div>
                  </div>
                  <div class="modal-footer border-secondary p-4">
                    <button type="submit" class="btn btn-wood w-100 py-3">Feltöltés</button>
                  </div>
                </form>
              </div>
            </div>
            <% } %>

<!-- ELŐTTE/UTÁNA TAB -->
            <% if(tab == 'before-after') { %>
            <div class="d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
                <div>
                    <h3 class="fw-bold m-0 text-white"><i class="fa-solid fa-arrow-right-arrow-left me-2 text-warning"></i> Előtte / Utána projektek</h3>
                    <p class="text-muted mb-0 mt-2">Összehasonlító képek a főoldalon megjelenítve.</p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><i class="fa-solid fa-plus me-2 text-warning"></i> Új előtte/utána projekt</div>
                <div class="card-body">
                    <form action="/admin/before-after/add" method="POST" enctype="multipart/form-data" class="row g-3">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Cím *</label>
                            <input type="text" name="title" class="form-control" placeholder="pl. Nappali felújítás" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Sorrend</label>
                            <input type="number" name="sort_order" class="form-control" value="0">
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted small">Leírás (opcionális)</label>
                            <textarea name="description" class="form-control" rows="2" placeholder="Rövid leírás a munkáról"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Előtte kép</label>
                            <input type="file" name="before_image" class="form-control" accept="image/*" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Utána kép</label>
                            <input type="file" name="after_image" class="form-control" accept="image/*" required>
                        </div>
                        <div class="col-12 text-end">
                            <button type="submit" class="btn btn-wood"><i class="fa-solid fa-plus me-2"></i> Hozzáadás</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead><tr><th style="width:60px"></th><th>Cím</th><th>Előtte</th><th>Utána</th><th>Státusz</th><th style="width:200px"></th></tr></thead>
                        <tbody>
                            <% (beforeAfterItems || []).forEach(item => { %>
                            <tr>
                                <td class="text-muted"><%= item.id %></td>
                                <td>
                                    <div class="fw-bold"><%= item.title %></div>
                                    <% if (item.description) { %><div class="small text-muted"><%= item.description %></div><% } %>
                                </td>
                                <td>
                                    <% if (item.before_image) { %><img src="<%= item.before_image.startsWith('http') ? item.before_image : '/uploads/' + item.before_image %>" style="height:48px;width:64px;object-fit:cover;border-radius:6px;" alt="előtte"><% } else { %><span class="text-muted small">—</span><% } %>
                                </td>
                                <td>
                                    <% if (item.after_image) { %><img src="<%= item.after_image.startsWith('http') ? item.after_image : '/uploads/' + item.after_image %>" style="height:48px;width:64px;object-fit:cover;border-radius:6px;" alt="utána"><% } else { %><span class="text-muted small">—</span><% } %>
                                </td>
                                <td>
                                    <% if (item.is_active) { %><span class="badge bg-success">Aktív</span><% } else { %><span class="badge bg-secondary">Inaktív</span><% } %>
                                </td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <button class="btn btn-sm btn-outline-light" data-bs-toggle="modal" data-bs-target="#editBeforeAfterModal<%= item.id %>"><i class="fa-solid fa-pen"></i></button>
                                        <form action="/admin/before-after/toggle/<%= item.id %>" method="POST">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="fa-solid <%= item.is_active ? 'fa-eye-slash' : 'fa-eye' %>"></i></button>
                                        </form>
                                        <form action="/admin/before-after/delete/<%= item.id %>" method="POST" data-confirm="Biztosan törlöd ezt az előtte/utána projektet?">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                            <% if (!beforeAfterItems || beforeAfterItems.length === 0) { %>
                            <tr><td colspan="6" class="text-center py-5 text-muted">Még nincs előtte/utána projekt.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

<!-- Szerkesztő modálok -->
            <% (beforeAfterItems || []).forEach(item => { %>
            <div class="modal fade" id="editBeforeAfterModal<%= item.id %>" tabindex="-1">
              <div class="modal-dialog modal-lg">
                <form action="/admin/before-after/update/<%= item.id %>" method="POST" enctype="multipart/form-data" class="modal-content bg-dark text-white border-0">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="modal-header border-secondary">
                    <h5 class="modal-title fw-bold">Előtte/Utána szerkesztése</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                  </div>
                  <div class="modal-body">
