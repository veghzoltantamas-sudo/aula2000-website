<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= code %> — Aula 2000</title>
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;700&family=Open+Sans:wght@300;400;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/vendor/fontawesome/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/error.css">
</head>
<body>
    <div class="glow-circle glow-1"></div>
    <div class="glow-circle glow-2"></div>
    <div class="error-container">
        <div class="error-icon"><i class="fa-solid fa-compass-drafting"></i></div>
        <div class="error-code"><%= code %></div>
        <div class="error-message"><%= message %></div>
        <p class="error-hint">Kérjük, ellenőrizd a webcímét, vagy térj vissza a főoldalra.</p>
        <a href="<%= backUrl || '/' %>" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i> Vissza a főoldalra
        </a>
    </div>
</body>
</html>
