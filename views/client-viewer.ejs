<!DOCTYPE html>
<html lang="hu">
<head>
    <%- include('partials/index-head') %>
    <title><%= file.original_name %> - Ügyfélkapu</title>
    <style>
        body, html { height: 100%; margin: 0; background: #1a1a1a; overflow: hidden; font-family: sans-serif; color: #fff; }
        .viewer-container { display: flex; flex-direction: column; height: 100vh; }
        .viewer-header { background: #222; color: #fff; padding: 10px 15px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; flex-shrink: 0; z-index: 10; }
        .viewer-header h1 { font-size: 0.95rem; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 45%; font-weight: normal; color: #eee; }
        .viewer-content { flex-grow: 1; position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #1a1a1a; }
        .viewer-content img { max-width: 100%; max-height: 100%; object-fit: contain; }
        .viewer-content iframe { width: 100%; height: 100%; border: none; background: #fff; display: block; }
        .btn-close { color: #888; text-decoration: none; font-size: 1.8rem; line-height: 1; transition: color 0.2s; padding: 0 5px; }
        .btn-close:hover { color: #fff; }
        .viewer-actions { display: flex; gap: 8px; align-items: center; }
        .btn-action { background: #444; color: #eee; padding: 6px 12px; border-radius: 4px; text-decoration: none; font-size: 0.8rem; transition: all 0.2s; display: inline-flex; align-items: center; gap: 6px; border: 1px solid #555; }
        .btn-action:hover { background: #555; color: #fff; border-color: #777; }
        .btn-primary-action { background: #ca8a04; border-color: #eab308; color: #fff; }
        .btn-primary-action:hover { background: #a16207; border-color: #ca8a04; }
        
        .mobile-pdf-view { display: none; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 30px; }
        .mobile-pdf-view i { font-size: 4rem; color: #ca8a04; margin-bottom: 20px; }
        .mobile-pdf-view h2 { font-size: 1.2rem; margin-bottom: 10px; color: #fff; }
        .mobile-pdf-view p { font-size: 0.9rem; color: #888; margin-bottom: 25px; max-width: 250px; }
        .btn-large { padding: 12px 24px; font-size: 1rem; border-radius: 8px; }

        @media (max-width: 768px) {
            .desktop-only-iframe { display: none !important; }
            .mobile-pdf-view { display: flex !important; }
            .viewer-header h1 { max-width: 35%; }
        }
    </style>
</head>
<body>
    <div class="viewer-container">
        <header class="viewer-header">
            <h1><%= file.original_name %></h1>
            <div class="viewer-actions">
                <a href="<%= fileUrl %>?dl=1" class="btn-action" title="Letöltés">
                    <i class="bi bi-download"></i> <span class="d-none d-sm-inline">Letöltés</span>
                </a>
                <a href="/ugyfel/projekt" class="btn-close" title="Bezárás">&times;</a>
            </div>
        </header>
        <main class="viewer-content">
            <% if (isImage) { %>
                <img src="<%= fileUrl %>" alt="<%= file.original_name %>">
            <% } else if (isPdf) { %>
                <iframe src="<%= fileUrl %>" class="desktop-only-iframe" title="PDF megjelenítő"></iframe>
                <div class="mobile-pdf-view">
                    <i class="bi bi-file-earmark-pdf"></i>
                    <h2>PDF Dokumentum</h2>
                    <p><%= file.original_name %></p>
                    <a href="<%= fileUrl %>" target="_blank" class="btn-action btn-primary-action btn-large">
                        <i class="bi bi-box-arrow-up-right"></i> Dokumentum megnyitása
                    </a>
                </div>
            <% } else if (isVideo) { %>
                <video controls autoplay style="max-width: 100%; max-height: 100%;">
                    <source src="<%= fileUrl %>" type="<%= file.mime_type %>">
                    A böngészője nem támogatja a videó lejátszását.
                </video>
            <% } else { %>
                <div style="color: #fff; text-align: center; padding: 20px;">
                    <i class="bi bi-file-earmark-lock" style="font-size: 3rem; color: #444; margin-bottom: 15px; display: block;"></i>
                    <p>Ez a fájltípus nem tekinthető meg közvetlenül.</p>
                    <a href="<%= fileUrl %>?dl=1" class="btn-action btn-primary-action">Fájl letöltése</a>
                </div>
            <% } %>
        </main>
    </div>
</body>
</html>
