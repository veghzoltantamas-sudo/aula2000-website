<!DOCTYPE html>
<html lang="hu">
<head>
    <meta name="description" content="Aula 2000 blog — építészeti tippek, inspiráció és szakmai cikkek.">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Blog — <%= (settings && settings.pwa_name) || 'Aula 2000' %>">
    <meta property="og:description" content="Építészeti tippek, inspiráció és szakmai cikkek az Aula 2000 irodájából.">
    <meta property="og:image" content="/icons/icon-512.png">
    <meta name="twitter:card" content="summary_large_image">
    <title>Blog — <%= (settings && settings.pwa_name) || 'Aula 2000' %></title>
    <%- include('partials/blog-head') %>
    <link rel="stylesheet" href="/css/blog.css">
</head>
<body>
    <%- include('partials/blog-nav') %>

    <div class="blog-hero">
        <div class="container">
            <h1>Blog</h1>
            <p>Építészeti tippek, ötletek és szakmai cikkek</p>
        </div>
    </div>

    <div class="container">
        <% if (categories && categories.length > 0) { %>
        <div class="blog-filters">
            <a href="/blog" class="<%= !activeCategory ? 'active' : '' %>">Mind</a>
            <% categories.forEach(cat => { %>
                <a href="/blog?cat=<%= encodeURIComponent(cat) %>" class="<%= activeCategory === cat ? 'active' : '' %>"><%= cat %></a>
            <% }) %>
        </div>
        <% } %>

        <% if (posts && posts.length > 0) { %>
        <div class="blog-grid">
            <% posts.forEach(post => { %>
            <div class="blog-card">
                <% if (post.cover) { %>
                <% const bcSep = post.cover.includes('?') ? '&' : '?'; %>
                <% const bcW = (w) => post.cover.includes('unsplash.com') ? `${post.cover}${bcSep}w=${w}` : post.cover; %>
                <img src="<%= bcW(600) %>"
                     srcset="<%= bcW(400) %> 400w,
                             <%= bcW(600) %> 600w,
                             <%= bcW(800) %> 800w,
                             <%= post.cover %> 1200w"
                     sizes="(max-width: 576px) 100vw,
                            (max-width: 992px) 50vw,
                            33vw"
                     alt="<%= post.title %>" loading="lazy" decoding="async" width="1200" height="800">
                <% } else { %>
                <div class="blog-card-noimage" style="height:170px;background:linear-gradient(135deg,rgba(213,171,93,0.15),rgba(213,171,93,0.03));display:flex;align-items:center;justify-content:center;color:rgba(213,171,93,0.7);font-size:2.2rem;">
                    <i class="fa-solid fa-compass-drafting"></i>
                </div>
                <% } %>
                <div class="blog-card-body">
                    <% if (post.category) { %><div class="blog-card-cat"><%= post.category %></div><% } %>
                    <h3><a href="/blog/<%= post.slug %>"><%= post.title %></a></h3>
                    <p><%= post.excerpt || '' %></p>
                    <div class="blog-card-meta">
                        <span><i class="fa-regular fa-calendar me-1"></i><%= post.created_at ? new Date(post.created_at).toLocaleDateString('hu-HU') : '' %></span>
                        <span><i class="fa-regular fa-eye me-1"></i><%= post.views || 0 %> megtekintés</span>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
        <% } else { %>
        <div class="blog-empty">
            <i class="fa-solid fa-pen-nib"></i>
            <h3>Még nincsenek bejegyzések</h3>
            <p>Hamarosan érdekes cikkekkel jelentkezünk!</p>
        </div>
        <% } %>

        <% if (totalPages > 1) { %>
        <nav class="mt-4 d-flex justify-content-center" aria-label="Blog lapozás">
            <ul class="pagination" style="gap:0.4rem">
                <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                    <a class="page-link" style="background:var(--panel);border:1px solid rgba(213,171,93,0.15);color:var(--text)" href="/blog?<%= activeCategory ? 'cat=' + encodeURIComponent(activeCategory) + '&' : '' %>page=<%= currentPage - 1 %>">Előző</a>
                </li>
                <% for (let p = 1; p <= totalPages; p++) { %>
                <li class="page-item <%= p === currentPage ? 'active' : '' %>">
                    <a class="page-link" style="background:<%= p === currentPage ? 'var(--gold)' : 'var(--panel)' %>;border:1px solid rgba(213,171,93,0.15);color:<%= p === currentPage ? '#111' : 'var(--text)' %>" href="/blog?<%= activeCategory ? 'cat=' + encodeURIComponent(activeCategory) + '&' : '' %>page=<%= p %>"><%= p %></a>
                </li>
                <% } %>
                <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                    <a class="page-link" style="background:var(--panel);border:1px solid rgba(213,171,93,0.15);color:var(--text)" href="/blog?<%= activeCategory ? 'cat=' + encodeURIComponent(activeCategory) + '&' : '' %>page=<%= currentPage + 1 %>">Következő</a>
                </li>
            </ul>
        </nav>
        <% } %>
    </div>

    <%- include('partials/blog-footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
